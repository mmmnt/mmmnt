{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"],
      "inputs": ["src/grammar/**/*.langium"]
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["dist/**"],
      "env": ["GH_APP_CLIENT_ID"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["generate", "^build"],
      "outputs": []
    },
    "docs": {
      "dependsOn": ["build"],
      "outputs": ["docs/api/**"]
    }
  }
}
