// ADR-041 invalid exemplar: V38 — every event of every outcome is declared; here the second is not.
context "Shop" [Core]
  aggregate "Order"
    identity orderId: UUID
    state initial Open
    state Open -> Packed on PackOrder
    command PackOrder
      emits OrderPacked, OrderGhost
    event OrderPacked
      orderId: UUID

flow "Pack"
  lane shop "Shop" [Core]
  moment "Packed"
    shop: PackOrder
    shop: OrderPacked
