// ADR-041 invalid exemplar: V46 — no two outcomes of a command carry the same state.
context "Shop" [Core]
  aggregate "Order"
    identity orderId: UUID
    state initial Open
    state Open -> Packed on PackOrder
    command PackOrder
      emits OrderPacked when Open | OrderLabelled when Open
    event OrderPacked
      orderId: UUID
    event OrderLabelled
      orderId: UUID

flow "Pack"
  lane shop "Shop" [Core]
  moment "Packed" [branch]
    when plain
      shop: PackOrder
      shop: OrderPacked
    when labelled
      shop: PackOrder
      shop: OrderLabelled
