// ADR-040 invalid exemplar: V41 — a placement names a cause the command does not declare.
context "Shop" [Core]
  aggregate "Order"
    identity orderId: UUID
    command CancelOrder
      causes OwnerRequest, ShopClosure
      precondition Window cause OwnerRequest: "Ahead of time"
      emits OrderCancelled
    event OrderCancelled
      orderId: UUID

flow "Cancel"
  lane shop "Shop" [Core]
  moment "Owner asks"
    shop: CancelOrder cause Typo
    shop: OrderCancelled
