// ADR-041 invalid exemplar: V47 — the events one placement of a command records come from one outcome.
context "Shop" [Core]
  aggregate "Order"
    identity orderId: UUID
    state initial Open
    state Open -> Packed on PackOrder
    command PackOrder
      emits OrderPacked when Open | OrderLabelled when Packed
    event OrderPacked
      orderId: UUID
    event OrderLabelled
      orderId: UUID

flow "Pack"
  lane shop "Shop" [Core]
  moment "Packed and labelled"
    shop: PackOrder
    shop: OrderPacked
    shop: OrderLabelled

flow "Pack plain"
  lane shop "Shop" [Core]
  moment "Packed"
    shop: PackOrder
    shop: OrderPacked

flow "Pack labelled"
  lane shop "Shop" [Core]
  moment "Labelled"
    shop: PackOrder
    shop: OrderLabelled
