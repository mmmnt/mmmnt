// ADR-040 corpus exemplar (ticketwave): a process that records its outcomes as events, and a command
// issued for two causes with a refusal that belongs to one of them.
context "Ticketing" [Core]
  aggregate "Customer"
    identity customerId: UUID
    command RegisterCustomer
      input customerId: UUID
      emits CustomerRegistered
    event CustomerRegistered
      customerId: UUID

  aggregate "FraudCheck"
    identity checkId: UUID
    command RequestFraudCheck
      input customerId: UUID
      emits FraudCheckRequested
    event FraudCheckRequested
      checkId: UUID
      customerId: UUID

  aggregate "SeatBlock"
    identity seatBlockId: UUID
    command HoldSeats
      input customerId: UUID
      emits SeatsHeld
    command ReleaseSeats
      input customerId: UUID
      emits SeatsReleased
    event SeatsHeld
      seatBlockId: UUID
      customerId: UUID
    event SeatsReleased
      seatBlockId: UUID

  aggregate "Receipt"
    identity receiptId: UUID
    command IssueReceipt
      input customerId: UUID
      emits ReceiptIssued
    event ReceiptIssued
      receiptId: UUID

  aggregate "Booking"
    identity bookingId: UUID
    command CancelBooking
      input bookingId: UUID
      causes CustomerRequest, OrganiserCancellation
      precondition BookingIsOpen: "The booking has not been fulfilled"
      precondition WithinRefundWindow cause CustomerRequest: "The customer cancels at least 24 hours ahead"
      emits BookingCancelled
    event BookingCancelled
      bookingId: UUID

  orchestration PurchaseProcess
    command StartPurchase
      input customerId: UUID
      precondition CustomerIsRegistered: "The customer has a ticketing record"
      emits PurchaseStarted
    command CompletePurchase
      emits PurchaseCompleted
    command AbandonPurchase
      emits PurchaseAbandoned
    event PurchaseStarted
      customerId: UUID
    event PurchaseCompleted
      customerId: UUID
      seatBlockId: UUID
    event PurchaseAbandoned
      customerId: UUID
    invoked-by StartPurchase
    issues RequestFraudCheck, HoldSeats
    states Started
    compensation on AbandonPurchase issues ReleaseSeats
    timeout purchaseWindow

  policy ReceiptOnPurchaseCompleted
    trigger PurchaseCompleted
    action "Send the customer a receipt for the purchase"
    chains-to IssueReceipt

  projection AbandonedPurchases
    sources PurchaseAbandoned
    description "How many purchases ended without completing"
    field customerId: UUID
