// ADR-040 corpus exemplar (vet-clinic): a process that records its outcomes as events, and a command
// issued for two causes with a refusal that belongs to one of them.
context "Clinic" [Core]
  aggregate "Pet"
    identity petId: UUID
    command RegisterPet
      input petId: UUID
      emits PetRegistered
    event PetRegistered
      petId: UUID

  aggregate "LabPanel"
    identity panelId: UUID
    command RequestLabPanel
      input petId: UUID
      emits LabPanelRequested
    event LabPanelRequested
      panelId: UUID
      petId: UUID

  aggregate "Ward"
    identity wardId: UUID
    command BookBed
      input petId: UUID
      emits BedBooked
    command ReleaseBed
      input petId: UUID
      emits BedReleased
    event BedBooked
      wardId: UUID
      petId: UUID
    event BedReleased
      wardId: UUID

  aggregate "Invoice"
    identity invoiceId: UUID
    command IssueInvoice
      input petId: UUID
      emits InvoiceIssued
    event InvoiceIssued
      invoiceId: UUID

  aggregate "Appointment"
    identity appointmentId: UUID
    command CancelAppointment
      input appointmentId: UUID
      causes OwnerRequest, ClinicClosure
      precondition AppointmentIsOpen: "The appointment has not been completed"
      precondition WithinCancellationWindow cause OwnerRequest: "The owner cancels at least 24 hours ahead"
      emits AppointmentCancelled
    event AppointmentCancelled
      appointmentId: UUID

  orchestration AdmissionProcess
    command StartAdmission
      input petId: UUID
      precondition PetIsRegistered: "The pet has a clinic record"
      emits AdmissionStarted
    command CompleteAdmission
      emits AdmissionCompleted
    command AbandonAdmission
      emits AdmissionAbandoned
    event AdmissionStarted
      petId: UUID
    event AdmissionCompleted
      petId: UUID
      bedId: UUID
    event AdmissionAbandoned
      petId: UUID
    invoked-by StartAdmission
    issues RequestLabPanel, BookBed
    states Started
    compensation on AbandonAdmission issues ReleaseBed
    timeout admissionWindow

  policy BillOnAdmissionCompleted
    trigger AdmissionCompleted
    action "Bill the owner for the stay"
    chains-to IssueInvoice

  projection AbandonedAdmissions
    sources AdmissionAbandoned
    description "How many admissions ended without completing"
    field petId: UUID
