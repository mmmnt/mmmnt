flow "Purchase"
  description "A customer purchases tickets, and the outcome is a fact others react to"

  lane ticketing "Ticketing" [Core]

  moment "Purchase starts"
    ticketing: StartPurchase
    ticketing: PurchaseStarted

  moment "Purchase completes"
    ticketing: CompletePurchase
    ticketing: PurchaseCompleted

  moment "The customer is sent a receipt"
    ticketing: ReceiptOnPurchaseCompleted
      triggered-by PurchaseCompleted
    ticketing: IssueReceipt
      triggered-by ReceiptOnPurchaseCompleted
