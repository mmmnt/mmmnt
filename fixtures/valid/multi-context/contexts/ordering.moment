context "Ordering" [Core]

  aggregate "Order"
    identity orderId: UUID

    command PlaceOrder
      input customerId: UUID, items: OrderItem[], shippingAddress: Address
      precondition orderNotPlaced: "Order has not already been placed"
      precondition itemsNotEmpty: "Order must contain at least one item"
      emits OrderPlaced

    event OrderPlaced
      orderId: UUID
      customerId: UUID
      items: OrderItem[]
      shippingAddress: Address
      placedAt: DateTime

  value-object OrderItem
    productId: UUID
    quantity: number
    unitPrice: Money

  value-object Address
    street: string
    city: string
    state: string
    postalCode: string
    country: string

  invariant ORD-01 "Order must contain at least one item"
    scope Order

  invariant ORD-02 "Shipping address must be complete"
    scope Order
