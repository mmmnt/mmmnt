context "ECommerce" [Core]

  aggregate "Order"
    identity orderId: UUID

    command PlaceOrder
      input customerId: UUID, items: OrderItem[], shippingAddress: Address
      precondition orderNotPlaced: "Order has not already been placed"
      precondition itemsNotEmpty: "Order must contain at least one item"
      emits OrderPlaced

    command CancelOrder
      input orderId: UUID, reason: string
      precondition orderNotShipped: "Order must not have been shipped"
      emits OrderCancelled

    command ConfirmPayment
      input orderId: UUID, paymentId: UUID, amount: Money
      emits PaymentConfirmed

    event OrderPlaced
      orderId: UUID
      customerId: UUID
      items: OrderItem[]
      shippingAddress: Address
      placedAt: DateTime

    event OrderCancelled
      orderId: UUID
      reason: string
      cancelledAt: DateTime

    event PaymentConfirmed
      orderId: UUID
      paymentId: UUID
      amount: Money
      confirmedAt: DateTime

  aggregate "Inventory"
    identity warehouseId: UUID

    command ReserveStock
      input orderId: UUID, items: OrderItem[]
      emits StockReserved

    command ReleaseStock
      input orderId: UUID, items: OrderItem[]
      emits StockReleased

    event StockReserved
      warehouseId: UUID
      orderId: UUID
      items: OrderItem[]
      reservedAt: DateTime

    event StockReleased
      warehouseId: UUID
      orderId: UUID
      items: OrderItem[]
      releasedAt: DateTime

  aggregate "Shipment"
    identity shipmentId: UUID

    command CreateShipment
      input orderId: UUID, items: OrderItem[], shippingAddress: Address
      emits ShipmentCreated

    command DispatchShipment
      input shipmentId: UUID, carrier: string, trackingNumber: string
      precondition shipmentNotDispatched: "Shipment must not already be dispatched"
      emits ShipmentDispatched

    event ShipmentCreated
      shipmentId: UUID
      orderId: UUID
      shippingAddress: Address
      createdAt: DateTime

    event ShipmentDispatched
      shipmentId: UUID
      carrier: string
      trackingNumber: string
      dispatchedAt: DateTime

  value-object OrderItem
    productId: UUID
    quantity: number
    unitPrice: Money

  value-object Address
    street: string
    city: string
    state: string
    postalCode: string
    country: string

  invariant ORD-01 "Order must contain at least one item"
    scope Order

  invariant ORD-02 "Order total must not exceed credit limit"
    scope Order

  invariant INV-01 "Reserved quantity cannot exceed available stock"
    scope Inventory

  invariant SHP-01 "Shipment must have a valid shipping address"
    scope Shipment

  policy ReserveStockOnOrderPlaced
    trigger OrderPlaced
    action "Reserve stock for all items in the order"
    chains-to ReserveStock

  policy ReleaseStockOnOrderCancelled
    trigger OrderCancelled
    action "Release reserved stock when order is cancelled"
    chains-to ReleaseStock
