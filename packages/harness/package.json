{
  "name": "@mmmnt/harness",
  "description": "Test execution engine with event replay and contract assertion for Moment-derived test suites",
  "version": "0.3.0",
  "license": "FSL-1.1-Apache-2.0",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "homepage": "https://github.com/mmmnt/mmmnt/tree/main/packages/harness#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmmnt/mmmnt.git",
    "directory": "packages/harness"
  },
  "bugs": {
    "url": "https://github.com/mmmnt/mmmnt/issues"
  },
  "keywords": [
    "moment",
    "testing",
    "test-runner",
    "contract-testing",
    "event-replay",
    "assertion",
    "ddd"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@mmmnt/core": "workspace:*",
    "@mmmnt/derive": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
