  moment "T13.M2 · The proposal is made" [branch]
    when TheMainPath
      // the main path of the story
      design: Propose  // S:499,820 ContextMap Propose(change, source: the entry Pointer, created constructs, observed SubjectVersions)
        triggered-by PlacementDecided  // S:499 "2. ContextMap Propose(change, source: the entry Pointer" (policy ImpliesBoundaryProposes)
    when StaleVersions
      // former flow: t13-a-stale-proposal-is-withdrawn-in-the-same-write.moment
      // S: citations of the former flow that its nodes do not repeat (kept, none dropped):
      // carried from the former flow, its description: description "T13 — a Propose whose observed boundary versions differ from the current ones is proposed and withdrawn in one write: its created constructs are invalidated and the source is asked again. Spec of record S:849, S:880, S:892-893."
      // carried from the former flow, T13.M1 · A boundary change is stated or found: design: PlacementDecided  // S:498 "ImpliesBoundary"
      // carried from the former flow, T13.M1 · A boundary change is stated or found: design: StoreConstruct  // S:498 "StoreConstruct(proposedFor: BoundaryRatification) for each construct the change creates"
      // carried from the former flow, T13.M1 · A boundary change is stated or found: design: ConstructStored  // S:552 "ConstructStored {Arrival, attempt}"
      // T13.M2 · The proposal is made on versions that are already stale
      design: Propose  // S:849 "if the observed boundary versions differ from the current ones → BoundaryChangeProposed and ProposalWithdrawn in one write"
        triggered-by PlacementDecided  // S:499 "2. ContextMap Propose(change, source: the entry Pointer" (policy ImpliesBoundaryProposes)
      design: BoundaryChangeProposed  // S:836 "BoundaryChangeProposed {source, ratifiedBy?, ratifiedInline}"
      design: ProposalWithdrawn  // S:849 "BoundaryChangeProposed and ProposalWithdrawn in one write"
      // Nobody is asked: BoundaryChangeProposed asks only when it is "not withdrawn in the same write" (S:880).
      // T13.M6 · The cascade withdraws it
      design: SupersedeConstruct  // S:892 "SupersedeConstruct(by: none, cause: SubjectChanged) for each created construct"
        triggered-by ProposalWithdrawn  // S:892 "SupersedeConstruct(by: none, cause: SubjectChanged) for each created construct" (policy ProposalWithdrawnSupersedesCreated)
      design: ConstructInvalidated  // S:556 "ConstructInvalidated {cause, Pointer?, pass?}"
      design: PlacementMarkedStale  // S:893 "an entry source → Placement MarkStale(proposal)"
      clarification: AskQuestion  // S:511 "AskQuestion (subject: the entry Pointer; recipient: the source entry's author"
        triggered-by PlacementMarkedStale  // S:511 "PlacementMarkedStale → AskQuestion" (policy PlacementMarkedStaleAsksQuestion)
      clarification: QuestionAsked  // S:1033 "QuestionAsked {generation, causedBy, recipientRule"
      design: StartPass  // S:733 "StartPass(Convergence, scope: the customer workspace, model-wide)"
        triggered-by ProposalWithdrawn  // S:733 "a ContextMap proposal that ends with no construct to accept" (policy ProposalWithdrawnStartsConvergencePass)
      design: PassStarted [outcome]  // S:672 "PassStarted {startPosition, CorpusVersion, RulesVersion}"
      // T13.O13 · Settled (terminal)
      // note design: "The convergence read model folds the recorded events into the baseline and the inputs of the verdict"  // S:1002 "the convergence read model: the baseline per customer workspace"
      // PROVES: see the node before it; the verdict counts an open proposal or a blocking Gap (S:1002).
    when StaleVersionsRatifiedBy
      // former flow: t13-a-stale-proposal-with-ratifiedby-is-withdrawn.moment
      // S: citations of the former flow that its nodes do not repeat (kept, none dropped):
      // carried from the former flow, its description: description "T13 — a Propose that carries an operator as ratifiedBy but observed stale boundary versions is withdrawn in the same write and not ratified; the ratifiedBy answerer gets a notice. Spec of record S:849-850, S:894."
      // T13.M2 · The proposal is made on versions that are already stale
