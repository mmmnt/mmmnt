      triggered-by BoundaryChangeProposed  // S:880 "BoundaryChangeProposed (not ratifiedInline, not withdrawn in the same write)" (policy BoundaryChangeProposedAsksQuestion)

  moment "T13.M4 · An operator ratifies" [branch]
    clarification: QuestionAsked  // S:1033 the question shows the boundary versions (S:880)
    when TheMainPath
      // the main path of the story: no node here, the deciding event is the plain node above; the main path goes on in the moment that follows (founder ruling "Yes, anchor the branches": the deciding event is moved into the branch moment, the arm carries none of the main path's nodes)
    when Rejected
      // former flow: t13-a-boundary-change-is-rejected.moment (path 1 of 2)
      // T13.M5 · Or an operator rejects
      clarification: ResolveQuestion cause Answer  // S:1124 the answer to a BoundaryChangeProposed question routes to Ratify or Reject
      // A Gap-sourced proposal also gets DisposeGap(Resolved{Distinct}) (S:1334); this flow is entry-sourced.
      // T13.M5·B1 · when the answerer holds the operator role
      clarification: QuestionResolved  // S:1034
      // sees: no effect (Unauthorised) and a notice (S:1041-1042). NDD exit returns-to T13.M3: the question keeps its state (S:1042); the scenario ends at
      // the refusal here.
      // T13.M5·B2 · when the proposal is not open
      design: Reject  // S:833,848 only an operator rejects
        triggered-by QuestionResolved  // S:1124 "BoundaryChangeProposed → Ratify or Reject" (policy RoutingProposalAnswerRejects)
      design: BoundaryChangeRejected  // S:838,848
      design: StartPass  // S:733 "a ContextMap proposal that ends with no construct to accept"
        triggered-by BoundaryChangeRejected  // S:733 "a ContextMap proposal that ends with no construct to accept" (policy BoundaryChangeRejectedStartsConvergencePass)
      design: PassStarted  // S:672 "PassStarted {startPosition, CorpusVersion, RulesVersion}"
      design: SupersedeConstruct  // S:889 SupersedeConstruct(by: none, cause: Rejected) for each created construct
        triggered-by BoundaryChangeRejected  // S:889 "BoundaryChangeRejected → SupersedeConstruct(by: none, cause: Rejected)" (policy BoundaryChangeRejectedSupersedesCreated)
      design: ConstructInvalidated [outcome]  // S:556
      // T13.O13 · The boundary is settled (terminal)
      // note design: "The convergence read model folds the recorded events into the baseline and the inputs of the verdict"  // S:1002 the convergence read model: every ContextMap proposal that is open
      // PROVES: no open proposal in the convergence read model for the change (S:1002)
    when RejectedWhenTheProposalIsNotOpen
      // former flow: t13-a-boundary-change-is-rejected.moment (path 2 of 2)
      // S: citations of the former flow that its nodes do not repeat (kept, none dropped):
      // carried from the former flow, its header: DIFFERENCE FROM NDD-SOURCE (spec wins): T13.M5 had no branches in NDD; the spec gives Reject the same two refusals as Ratify (S:856-858), so M5·B1
      // carried from the former flow, its description: description "T13 — a proposed boundary change is rejected by an operator: the created constructs are invalidated. Spec of record S:833, S:858-859, S:889."
      // carried from the former flow, T13.M5·B2 · when the proposal is not open: when TheProposalIsOpen [design]  // S:858
      // T13.M5 · Or an operator rejects
      clarification: ResolveQuestion cause Answer  // S:1124 the answer to a BoundaryChangeProposed question routes to Ratify or Reject
      // A Gap-sourced proposal also gets DisposeGap(Resolved{Distinct}) (S:1334); this flow is entry-sourced.
      // T13.M5·B1 · when the answerer holds the operator role
      clarification: QuestionResolved  // S:1034
      // sees: no effect (Unauthorised) and a notice (S:1041-1042). NDD exit returns-to T13.M3: the question keeps its state (S:1042); the scenario ends at
      // the refusal here.
      // T13.M5·B2 · when the proposal is not open
      design: Reject  // S:833,847 on a proposal that is not open
        triggered-by QuestionResolved  // S:1124 "BoundaryChangeProposed → Ratify or Reject" (policy RoutingProposalAnswerRejects)
      design: RatificationRefused [terminal]  // S:840,847 {proposal, reason: NotOpen, actor}
      // sees: RatificationRefused{NotOpen}, then a notice to the answerer (S:895); a repeat with the same answer ref is a silent no-op (S:854). NDD
      // terminal T13.N2.
      // T13.O13 · The boundary is settled (terminal)
      // note design: "The convergence read model folds the recorded events into the baseline and the inputs of the verdict"  // S:1002 the convergence read model: every ContextMap proposal that is open
      // PROVES: no open proposal in the convergence read model for the change (S:1002)
    when Withdrawn
      // former flow: t13-a-boundary-change-is-withdrawn.moment
      // S: citations of the former flow that its nodes do not repeat (kept, none dropped):
      // carried from the former flow, its description: description "T13 — an open proposal is withdrawn when a boundary version in its read set increments: its question is closed, its created constructs are invalidated and the source is asked again. Spec of record S:839, S:845-846, S:860, S:890-894."
      // T13.M6 · Or the world changes under it
      design: RetireProvisional  // S:834,849 increments that construct's boundary version, then cascades (a content write, a rename or a move of a construct in the proposal's read set does the same)
      design: ProvisionalRetired  // S:841
      design: ProposalWithdrawn  // S:845,828 {SubjectChanged, by event}, in the same write, actor system
