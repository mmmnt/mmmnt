  policy AppliedAcrossSourcesStartsLivePassOnAnswer  // S:504 "Applied across sources under SourceAuthority Sift"; row S:1306 "| AnswerApplied | outcome policies (the Defer{Contradiction} and Defer" // board: P3-15a-ans
    trigger AnswerApplied
    action "Applied across sources under SourceAuthority Sift, a: StartPass(Live, scope: the target) [the AnswerApplied twin of AppliedAcrossSourcesStartsLivePass: the outcome policies are shared by PlacementDecided and AnswerApplied]"
    chains-to StartPass

  policy AppliedAcrossSourcesObservesGapOnAnswer  // S:504 "Applied across sources under SourceAuthority Sift"; row S:1306 "| AnswerApplied | outcome policies (the Defer{Contradiction} and Defer" // board: P3-15b-ans
    trigger AnswerApplied
    action "Applied across sources under SourceAuthority Sift, b: ObserveGap (Divergence, Covered{sourceAuthority}) in that pass · never blocking, never asked [the AnswerApplied twin of AppliedAcrossSourcesObservesGap: the outcome policies are shared by PlacementDecided and AnswerApplied]"
    chains-to ObserveGap

  policy StatedReplacementStartsLivePassOnAnswer  // S:514 "exactly one, X, that the divergence gate (above) covers"; row S:1306 "| AnswerApplied | outcome policies (the Defer{Contradiction} and Defer" // board: P3-20a-ans
    trigger AnswerApplied
    action "Stated replacement (outcome stores / accepts C), a exactly one X the divergence gate covers: StartPass(Live, X) [the AnswerApplied twin of StatedReplacementStartsLivePass: the outcome policies are shared by PlacementDecided and AnswerApplied]"
    chains-to StartPass

  policy StatedReplacementObservesGapOnAnswer  // S:514 "exactly one, X, that the divergence gate (above) covers"; row S:1306 "| AnswerApplied | outcome policies (the Defer{Contradiction} and Defer" // board: P3-20a2-ans
    trigger AnswerApplied
    action "Stated replacement a: then ObserveGap (Steer under Ask; Covered{sourceAuthority} under Sift / Conversation) [the AnswerApplied twin of StatedReplacementObservesGap: the outcome policies are shared by PlacementDecided and AnswerApplied]"
    chains-to ObserveGap

  policy StatedReplacementSupersedesReplacedOnAnswer  // S:515 "exactly one, X, otherwise, and this entry is a deciding entry"; row S:1306 "| AnswerApplied | outcome policies (the Defer{Contradiction} and Defer" // board: P3-20b-ans
    trigger AnswerApplied
    action "Stated replacement b exactly one X and a deciding entry: SupersedeConstruct(X, by C, cause Stated) [the AnswerApplied twin of StatedReplacementSupersedesReplaced: the outcome policies are shared by PlacementDecided and AnswerApplied]"
    chains-to SupersedeConstruct

  policy StatedReplacementProposesReplaceOnAnswer  // S:515 "exactly one, X, otherwise, and this entry is a deciding entry"; row S:1306 "| AnswerApplied | outcome policies (the Defer{Contradiction} and Defer" // board: P3-20b2-ans
    trigger AnswerApplied
    action "Stated replacement b exactly one X and a deciding entry: or Propose(replace) [the AnswerApplied twin of StatedReplacementProposesReplace: the outcome policies are shared by PlacementDecided and AnswerApplied]"
    chains-to Propose

  policy StatedReplacementAsksRetirementQuestionOnAnswer  // S:516 "exactly one, and this entry is not a deciding entry, or several"; row S:1306 "| AnswerApplied | outcome policies (the Defer{Contradiction} and Defer" // board: P3-20c-ans
    trigger AnswerApplied
    action "Stated replacement c exactly one X non-deciding, or several: AskQuestion (retirement for this entry) · d none: nothing; then members of a retired BC / Aggregate listed in the same question [the AnswerApplied twin of StatedReplacementAsksRetirementQuestion: the outcome policies are shared by PlacementDecided and AnswerApplied]"
    chains-to AskQuestion

  policy StatedNegationSupersedesNegatedOnAnswer  // S:519 "Stated negation (Round 28; 3d95589b S1):"; row S:1306 "| AnswerApplied | outcome policies (the Defer{Contradiction} and Defer" // board: P3-21a-ans
    trigger AnswerApplied
    action "Stated negation (deciding entry): SupersedeConstruct(X, none, cause Stated) [the AnswerApplied twin of StatedNegationSupersedesNegated: the outcome policies are shared by PlacementDecided and AnswerApplied]"
    chains-to SupersedeConstruct

  policy StatedNegationProposesRetireOnAnswer  // S:519 "Stated negation (Round 28; 3d95589b S1):"; row S:1306 "| AnswerApplied | outcome policies (the Defer{Contradiction} and Defer" // board: P3-21b-ans
    trigger AnswerApplied
    action "Stated negation (deciding entry): or Propose(retire X) [the AnswerApplied twin of StatedNegationProposesRetire: the outcome policies are shared by PlacementDecided and AnswerApplied]"
    chains-to Propose

  policy StatedNegationAsksRetirementQuestionOnAnswer  // S:519 "Stated negation (Round 28; 3d95589b S1):"; row S:1306 "| AnswerApplied | outcome policies (the Defer{Contradiction} and Defer" // board: P3-21c-ans
    trigger AnswerApplied
    action "Stated negation (deciding entry): or listed in the retirement question [the AnswerApplied twin of StatedNegationAsksRetirementQuestion: the outcome policies are shared by PlacementDecided and AnswerApplied]"
    chains-to AskQuestion

  policy ProposalWithdrawnWithdrawsQuestion  // S:891 "ResolveQuestion(Withdrawn) for its ratification question"; row S:1335 "| ProposalWithdrawn | ResolveQuestion(Withdrawn); SupersedeConstruct(S" // board: P3-93a
    trigger ProposalWithdrawn
    action "ResolveQuestion(Withdrawn) (+ notice)"
    chains-to ResolveQuestion

  policy ProposalWithdrawnSupersedesCreated  // S:892 "SupersedeConstruct(by: none, cause: SubjectChanged) for each created construct"; row S:1335 "| ProposalWithdrawn | ResolveQuestion(Withdrawn); SupersedeConstruct(S" // board: P3-93b
    trigger ProposalWithdrawn
    action "SupersedeConstruct(none, SubjectChanged) per created construct"
    chains-to SupersedeConstruct

  policy ProposalWithdrawnMarksPlacementStale  // S:893 "an entry source → Placement MarkStale(proposal)"; row S:1335 "| ProposalWithdrawn | ResolveQuestion(Withdrawn); SupersedeConstruct(S" // board: P3-93c
    trigger ProposalWithdrawn
    action "entry source: MarkStale(proposal); Gap source: DisposeGap (GapSourcedProposalRatifiedDisposesGap); a notice to the answerer if the Propose carried ratifiedBy"
    chains-to MarkStale

  policy ProvisionalRetiredSupersedes  // S:896 "ProvisionalRetired → SupersedeConstruct(by: none"; row S:1337 "| ProvisionalRetired | SupersedeConstruct(by: none, cause: Answered, o" // board: P3-95
    trigger ProvisionalRetired
    action "SupersedeConstruct(by none, cause Answered | Computed)"
    chains-to SupersedeConstruct

  policy DroppedWordAppliesComputedAnswer  // S:520 "Dropped word (Round 28; c9256057):"; row S:1305 "| PlacementDecided | outcome policies"
    trigger PlacementDecided
    action "a glossary section or an owner sentence of the newest document version drops a word: for each live Term of that word, ApplyAnswer(computed{dropped-word}) on that Term's Placement (Retire)"
    chains-to ApplyAnswer

  policy DroppedWordAppliesComputedAnswerOnAnswer  // S:520 "Dropped word (Round 28; c9256057):"; row S:1306 "| AnswerApplied | outcome policies"
    trigger AnswerApplied
    action "a glossary section or an owner sentence of the newest document version drops a word: for each live Term of that word, ApplyAnswer(computed{dropped-word}) on that Term's Placement (Retire)"
    chains-to ApplyAnswer

  policy AdmittedGateDecisionStartsCycle  // S:982 "An Admitted decision is followed by StartCycle"; row S:1352 "| GateDecisionRecorded | StartCycle"
    trigger GateDecisionRecorded when decision = Admitted
    action "an Admitted decision starts the Cycle: StartCycle follows it"
    chains-to StartCycle

  policy CycleCompletedMarksProcessed  // S:344 "is the unit of work's last command, issued after CycleCompleted{Succeeded} is recorded"; row S:1347 "| CycleCompleted | external consumers"
    trigger CycleCompleted when outcome = Succeeded
    action "MarkProcessed is the unit of work's last command, issued after CycleCompleted{Succeeded} is recorded"
    chains-to MarkProcessed

  policy PassTriggerRecordedStartsConvergencePass  // S:341 "A policy on PassTriggerRecorded issues StartPass(Convergence, model-wide)"; row S:1353 "| PassTriggerRecorded | the policy on it"
    trigger PassTriggerRecorded
    action "on PassTriggerRecorded, StartPass(Convergence, scope: the customer workspace, model-wide), for a redo, for every erasure and for a closure at dispatch; the pass is the Cycle's own, so CompleteCycle follows it"
    chains-to StartPass

  // --------------------------------------------------------------------------
  // NOT A DECLARED CONSTRUCT (notes; the spec's rules that Moment has no construct for)
  // --------------------------------------------------------------------------
  //  - The policies that issue SupersedeConstruct (Stored(supersedes), stated replacement, stated negation, retirement routing), when the successor fails the guard, issue
  //    RefuseSupersession instead; reason Self | NotLive | NotHead.  // S:648 "the policies that issue SupersedeConstruct (the Stored(supersedes) policy, the stated-replacement and stated-negation policies, retirement routing), when the successor fails the guard"
  //  - CorpusVersionReleased (external) is a pass trigger for every customer workspace that has Sift, after the Sift-workspaces read model has caught up; the admission gate
  //    decides per customer workspace and a disabled one picks it up in its Resume pass: a fan-out, not a policy.  // S:737 "CorpusVersionReleased (external, from the corpus release pipeline) → a pass trigger for every customer workspace that has Sift"
  //  - ThresholdOverridden is a pass trigger for that customer workspace, or for License scope every inheriting one: a fan-out, not a policy.  // S:738 "ThresholdOverridden → a pass trigger for that customer workspace"
  //  - A pass trigger whose CorpusVersion or RulesVersion is older than the one read at its startPosition is NoOp{stale-trigger} (precondition of StartPass).  // S:735 "A pass trigger whose CorpusVersion or RulesVersion is older than the one read at its startPosition is NoOp{stale-trigger}"
  //  - The session-boundary arm of the question sweep (a feed entry of the boundary kind) has no command trigger: the entry's Cycle runs the sweep, then flushes the gathered postings.  // S:1100 "a step of the session-boundary entry's Cycle, run before it flushes the postings"
  //  - The Replay's one flush and the intake's one flush are the question poster's, an external call with a key, not a command.  // S:258 "The Replay's one flush follows the pass"
  //  - A GapOpened on a provisional construct is awaiting placement: no command, nothing asked; released by GapsAwaitingPlacementReleased. Steer and Contradiction Gaps are never awaiting placement.  // S:796 "if the construct is provisional"
  //  - Rationale refresh: a GapObserved with a different rationale on an Open Gap records the new finding, and the open question's body is the current rationale (no command).  // S:818 "Rationale refresh"
  //  - RatificationRefused{NotOpen} -> a notice to the answerer (a poster side effect).  // S:895 "RatificationRefused{NotOpen} → a notice to the answerer"
  //
  // The global current CorpusVersion read model: CorpusVersionReleased (external) · CorpusVersion read at startPosition
  // The agent workspace (Sift's construct memory in its own flmnt workspace): every Cycle's writes through the agent-workspace writer; each
  //      construct entry stamped with the construct ID, superseding the previous (SUPERSEDED_BY) · the construct's current agent-workspace entry
  //      = head; flmnt's context query over it (PlacementResolution step 3, last); a Sift pointer resolves to the head · held in flmnt: NOT
  //      encrypted at application level (OPS-03, H1); also writes the Sift pointer into the customer's flmnt workspace
  // Data stores (teal): Sift's own KurrentDB (the event store, kept for ever; ADR-080), read-model stores partitioned by key generation ,
  //      held document sections (each under its own data key).
  // Replay point: a direct query over Receipts, NOT a read model (see Intake).
  // Cycle records (process events of the SequenceRecords orchestration above): CycleStarted {CycleId, trigger, attempt}; NodeChanged {Pointer, CycleId} per write; CycleCompleted
  //      {Succeeded | Failed, constructStates, designState, position}; SagaStepFailed {step?, codes and Pointers}; SG.Cycle failure path: step
  //      fails -> brief retries (SysArch default) -> SagaStepFailed -> CycleCompleted{Failed} + alarm -> RecordFailedAttempt -> the work moves on.
  // Settled order note (not a hotspot): the spec fixes 'MootGap(Erased) after ReadModelsDestroyed and before the erasure's model-wide pass' (S:788,
  //      S:817); Accepted ADR-082 D6 fixes the Receipt closures (closures, then the settle step).
  // Resolvers named in the Gap aggregate (S:797-806): DEF-003, DEF-005, TAC-011, DUP, DEF-008, LAN-006, owner keeping, missing-arm;
  //      Placement-sourced: restated-arm, section-context, term-use, dropped-word, source-authority. The carry (finding identity, lineage root; never
  //      for a Contradiction or Divergence). RecordLag hold (cites a passage and names an empty rule input; the hold ends when the question is asked again).
  // Finding kinds: Plain | Duplicate{inBoundary} | BoundaryDuplicate | Contradiction | Divergence | Declined | Unevaluable; assessment gates = duplicate
  //      gate (DUP) + GateRun; placement gates are in Placement. Gap states: Open{handling} (in at most one hold: awaiting placement, or Held) |
  //      Resolved{Fixed|SameAs|Distinct} | Waived{ruling} | Mooted{cause} (only Mooted terminal; Mooted{Evaluated} reopenable by a later Plain /
  //      Duplicate / BoundaryDuplicate / Divergence finding). Handling: Ask | Refuse | Boundary | Steer | Covered{undeclared | waiver | distinct |
  //      sourceAuthority | advisory | declined}. Blocking = Open with Ask, Boundary, Refuse or Steer.

  // --------------------------------------------------------------------------
  // RELATIONSHIPS (section 0.1)
  // --------------------------------------------------------------------------
  relationship DesignModel -> Clarification  // S:181 "C3 <-> C4: Partnership."
    type Partnership
    contract "Gaps, Placements and proposals ask (AskQuestion); answers route back (QuestionResolved routing)"

  relationship DesignModel -> Flmnt  // S:187 "C3 -> the customer's flmnt workspace (Sift pointers, Round 23): Conformist to flmnt's write contract"
    type Conformist
    contract "flmnt's write contract (PTR), by the agent-workspace writer; flmnt's self-write guard keeps Sift pointers off the feed"

  relationship CorpusReleasePipeline -> DesignModel  // S:192 "the corpus release -> C3 and C5: Conformist (CorpusVersionReleased)."
    type Conformist
    contract "CorpusVersionReleased"

  relationship DesignModel -> Consumers  // S:193 "C3 -> consumers of the emitted Cycle: Published Language"
    type PublishedLanguage
    contract "CycleStarted -> NodeChanged -> CycleCompleted, with Pointers (ADR-084)"

  relationship Clarification -> DesignModel  // S:181 "C3 <-> C4: Partnership."
    type Partnership
    contract "answers route back (QuestionResolved routing); the partnership is two-way"
