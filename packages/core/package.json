{
  "name": "@mmmnt/core",
  "description": "Parser and intermediate representation for the Moment domain specification language",
  "version": "0.3.1",
  "license": "FSL-1.1-Apache-2.0",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "homepage": "https://github.com/mmmnt/mmmnt/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmmnt/mmmnt.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mmmnt/mmmnt/issues"
  },
  "keywords": [
    "moment",
    "dsl",
    "domain-driven-design",
    "ddd",
    "langium",
    "parser",
    "specification",
    "bounded-context",
    "aggregate",
    "event-storming"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "generate": "if [ -f src/grammar/moment.langium ]; then langium generate; fi",
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "langium-cli": "4.2.1"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "langium": "4.2.3",
    "yaml": "^2.8.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
