{
  "name": "moment",
  "scopeName": "source.moment",
  "fileTypes": [
    ".moment"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.moment",
      "match": "\\b(AnticorruptionLayer|Conformist|Core|CustomerSupplier|Date|DateTime|Generic|Money|OpenHostService|Partnership|PublishedLanguage|SeparateWays|Supporting|Terminal|UUID|action|aggregate|boolean|branch-lane|chains-to|command|compensation|consumes|context|contract|crosses-to|deprecated|description|emits|event|flow|identity|input|invariant|lane|moment|number|on|optional|policy|precondition|produces|relationship|returns-to|saga|scope|service|states|string|terminal|timeout|trigger|triggered-by|triggers|type|value-object|via|when)\\b|\\B(\"file-watcher\"|\"none\"|\\[branch\\]|\\[required\\])\\B"
    },
    {
      "name": "string.quoted.double.moment",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.moment"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.moment"
        },
        {
          "name": "comment.block.moment",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.moment"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.moment"
            }
          }
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.moment",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
