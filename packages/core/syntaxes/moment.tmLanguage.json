{
  "name": "moment",
  "scopeName": "source.moment",
  "fileTypes": [
    ".moment"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.moment",
      "match": "\\b(AnticorruptionLayer|PublishedLanguage|CustomerSupplier|OpenHostService|orchestration|compensation|precondition|relationship|SeparateWays|triggered-by|value-object|branch-lane|description|enforced-by|Partnership|Conformist|crosses-to|deprecated|invoked-by|projection|returns-to|Supporting|aggregate|chains-to|invariant|consumes|contract|DateTime|external|External|identity|optional|produces|terminal|Terminal|triggers|boolean|command|context|gateway|Generic|initial|service|sources|timeout|trigger|action|issues|moment|number|policy|states|string|emits|event|field|input|Money|query|reads|scope|state|Core|Date|flow|lane|none|rule|saga|term|type|UUID|when|via|on)\\b|\\B(\\[required\\]|\\[branch\\]|\"none\")\\B"
    },
    {
      "name": "string.quoted.double.moment",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.moment"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.moment"
        },
        {
          "name": "comment.block.moment",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.moment"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.moment"
            }
          }
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.moment",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
