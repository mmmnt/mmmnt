      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@mmmnt/core": "workspace:*",
    "@mmmnt/derive": "workspace:*"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^39.0.0",
    "@cucumber/messages": "^32.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
