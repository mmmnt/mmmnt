{
  "name": "@mmmnt/generate",
  "description": "Gherkin BDD scenarios, specification documents, and AsyncAPI contracts from Moment specifications",
  "version": "0.1.1",
  "license": "FSL-1.1-Apache-2.0",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "homepage": "https://github.com/mmmnt/mmmnt/tree/main/packages/generate#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmmnt/mmmnt.git",
    "directory": "packages/generate"
  },
  "bugs": {
    "url": "https://github.com/mmmnt/mmmnt/issues"
  },
  "keywords": [
    "moment",
    "gherkin",
    "bdd",
    "asyncapi",
    "specification",
    "documentation",
    "mermaid",
    "cucumber"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
