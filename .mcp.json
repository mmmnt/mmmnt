{
  "mcpServers": {
    "atlassian": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://winnovation.atlassian.net/",
        "JIRA_USERNAME": "${ATLASSIAN_USERNAME}",
        "JIRA_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "CONFLUENCE_URL": "https://winnovation.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "${ATLASSIAN_USERNAME}",
        "CONFLUENCE_API_TOKEN": "${ATLASSIAN_API_TOKEN}"
      }
    },
    "quorum": {
      "type": "http",
      "url": "http://localhost:8000/mcp",
      "headersHelper": "bash scripts/mcp-auth-header.sh"
    },
    "flmnt": {
      "type": "http",
      "url": "https://mcp.production.flmnt.ai/mcp",
      "headersHelper": "flmnt mcp auth-header --server-url https://mcp.production.flmnt.ai/mcp"
    }
  }
}
