pnpm exec lint-staged
if command -v gitleaks > /dev/null 2>&1; then
  gitleaks protect --staged --config .gitleaks.toml
fi

# Regenerate Facet scenario files when .moment specs change
STAGED_MOMENT=$(git diff --cached --name-only --diff-filter=ACM | grep '\.moment$' || true)
if [ -n "$STAGED_MOMENT" ]; then
  MOMENT="node packages/cli/dist/moment.mjs"
  for dir in examples/*/; do
    SPEC=$(find "$dir/spec" -name "*.moment" -maxdepth 1 2>/dev/null | head -1)
    if [ -n "$SPEC" ]; then
      # Only regenerate if this example's spec was staged
      if echo "$STAGED_MOMENT" | grep -q "^${dir}"; then
        $MOMENT simulate "$SPEC" --all --out-dir "${dir}facet" 2>/dev/null
        git add "${dir}facet/"
      fi
    fi
  done
fi
