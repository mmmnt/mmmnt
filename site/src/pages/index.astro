  <script>
    // Homepage hero — animate commit/reveal beats when the tab is visible.
    // Reduced-motion users see the final composed state without animation.
    class MomHeroAnim {
      root: HTMLElement | null;
      played = false;
      timers: number[] = [];
      onVis: () => void;

      constructor() {
        this.root = document.getElementById('momHero');
        this.onVis = () => {
          if (document.visibilityState === 'visible' && !this.played) this.play();
        };
      }

      mount() {
        if (!this.root) return;
        if (document.visibilityState === 'visible') {
          window.setTimeout(() => this.play(), 400);
        } else {
          document.addEventListener('visibilitychange', this.onVis);
        }
        const replay = document.getElementById('momReplay');
        if (replay) replay.addEventListener('click', () => this.play(true));
      }

      play(force = false) {
        const root = this.root;
        if (!root) return;
        const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
        if (reduce && !force) {
          this.played = true;
          return;
        }
        this.played = true;
        this.timers.forEach((t) => clearTimeout(t));
        this.timers = [];
        const nodes = Array.from(root.querySelectorAll<HTMLElement>('[data-kind]'));
        nodes.forEach((n) => {
          const k = n.dataset.kind;
          if (k === 'commit') {
            n.style.opacity = '0.32';
            n.style.borderLeftColor = 'transparent';
            n.style.background = 'transparent';
          } else if (k === 'reveal') {
            n.style.opacity = '0.28';
          } else {
            n.style.opacity = '0';
          }
        });
        nodes.forEach((n) => {
          const k = n.dataset.kind;
          const d = parseInt(n.dataset.delay ?? '0', 10) || 0;
          this.timers.push(
            window.setTimeout(() => {
              if (k === 'commit') {
                n.style.opacity = '1';
                n.style.borderLeftColor = 'rgba(34,211,238,0.55)';
                n.style.background = 'rgba(34,211,238,0.16)';
                this.timers.push(
                  window.setTimeout(() => {
                    n.style.background = 'rgba(34,211,238,0.05)';
                  }, 360),
                );
              } else if (k === 'reveal') {
                n.style.opacity = '0.92';
              } else {
                n.style.opacity = '1';
              }
            }, d),
          );
        });
        const pulse = document.getElementById('momPulsePath') as unknown as SVGAnimateMotionElement | null;
        if (pulse && 'beginElement' in pulse) {
          this.timers.push(
            window.setTimeout(() => {
              try {
                pulse.beginElement();
              } catch {}
            }, 2900),
          );
        }
      }
    }

    new MomHeroAnim().mount();
  </script>
