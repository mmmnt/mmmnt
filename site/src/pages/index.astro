---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { GITHUB_URL, GITHUB_WIKI_URL, SITE_URL, SITE_TITLE } from '../consts';

const description =
  'Moment is a specification language for temporal domains. Author contexts, events, and crossings as code — and Moment compiles them into a living flow you test in Facet, before any implementation exists.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Moment',
    description,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Cross-platform',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    license: 'https://fsl.software',
    codeRepository: GITHUB_URL,
    url: SITE_URL,
    programmingLanguage: 'TypeScript',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Moment',
    url: SITE_URL,
  },
];
---

<Base title={SITE_TITLE} description={description} jsonLd={jsonLd}>
  <div style="position:relative; overflow:hidden;">
    <Nav active="home" />

    {/* backdrop grid + glow */}
    <div
      style="position:absolute; inset:0; top:0; background-image:linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px); background-size:48px 48px; pointer-events:none;"
    >
    </div>
    <div
      style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:1100px; height:600px; background:radial-gradient(ellipse at center, rgba(34,211,238,0.1), transparent 70%); pointer-events:none;"
    >
    </div>

    {/* ===== HERO ===== */}
    <section
      class="site-container"
      style="position:relative; max-width:1200px; margin:0 auto; padding:70px 40px 30px; text-align:center;"
    >
      <div
        style="display:inline-flex; align-items:center; gap:9px; font-family:'JetBrains Mono',monospace; font-size:11.5px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:24px;"
      >
        <span
          style="width:6px; height:6px; border-radius:50%; background:#22D3EE; box-shadow:0 0 10px #22D3EE;"
        ></span>The Moment DSL · open-source temporal DDD
      </div>
      <h1
        style="font-weight:600; font-size:58px; line-height:1.04; letter-spacing:-.025em; margin:0 auto 22px; max-width:760px; color:#F2FBFC;"
      >
        Write the domain in code.<br />The flow <span style="color:#7FE9F5;">renders itself.</span>
      </h1>
      <p
        style="font-size:18px; line-height:1.6; color:#90A2AA; max-width:600px; margin:0 auto;"
      >
        Moment is a specification language for temporal domains. Author contexts, events, and
        crossings as code — and Moment compiles them into a living flow you test in <span
          style="color:#C9E8ED;">Facet</span
        >, before any implementation exists.
      </p>
    </section>

    {/* SHOWCASE */}
    <section
      id="momHero"
      class="site-container"
      style="position:relative; max-width:1200px; margin:0 auto; padding:22px 40px 30px;"
    >
      <div
        style="display:grid; grid-template-columns:minmax(0,1fr) 76px minmax(0,1.06fr); align-items:stretch;"
      >
        {/* CODE PANEL */}
        <div
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:14px; overflow:hidden; box-shadow:0 24px 60px rgba(0,0,0,.5);"
        >
          <div
            style="display:flex; align-items:center; justify-content:space-between; padding:13px 16px; border-bottom:1px solid rgba(255,255,255,0.07);"
          >
            <span style="font-family:'JetBrains Mono',monospace; font-size:12.5px; color:#7C8C92;"
              >order.moment</span
            >
            <span
              style="display:flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:11px; color:#22D3EE;"
              ><span
                style="width:6px;height:6px;border-radius:50%;background:#22D3EE;animation:momPulse 1.6s ease infinite;"
              ></span>authoring</span
            >
          </div>
          <div style="padding:18px 14px; font-family:'JetBrains Mono',monospace; font-size:13px; line-height:1.7;">
            <div
              data-kind="commit"
              data-delay="400"
              style="padding:2px 10px; border-left:2px solid rgba(34,211,238,0.55); background:rgba(34,211,238,0.05); opacity:1; transition:opacity .5s ease, border-color .5s ease, background .5s ease;"
            >
              <span style="color:#22D3EE;">context</span>
              <span style="color:#9DE6C6;">"Ordering"</span>
              <span style="color:#5b7077;">[Core]</span>
            </div>
            <div
              data-kind="commit"
              data-delay="750"
              style="padding:2px 10px; border-left:2px solid rgba(34,211,238,0.55); background:rgba(34,211,238,0.05); opacity:1; transition:opacity .5s ease, border-color .5s ease, background .5s ease;"
            >
              <span style="color:#22D3EE;">context</span>
              <span style="color:#9DE6C6;">"Fulfillment"</span>
              <span style="color:#5b7077;">[Supporting]</span>
            </div>
            <div style="height:10px;"></div>
            <div
              data-kind="commit"
              data-delay="1000"
              style="padding:2px 10px 2px 34px; border-left:2px solid rgba(34,211,238,0.55); background:rgba(34,211,238,0.05); opacity:1; transition:opacity .5s ease, border-color .5s ease, background .5s ease;"
            >
              <span style="color:#22D3EE;">aggregate</span> <span style="color:#9DE6C6;">"Order"</span>
            </div>
            <div
              data-kind="commit"
              data-delay="1200"
              style="padding:2px 10px 2px 58px; border-left:2px solid rgba(34,211,238,0.55); background:rgba(34,211,238,0.05); opacity:1; transition:opacity .5s ease, border-color .5s ease, background .5s ease;"
            >
              <span style="color:#22D3EE;">command</span>
              <span style="color:#E7C9A0;">PlaceOrder</span>
            </div>
            <div
              data-kind="reveal"
              data-delay="1400"
              style="padding:2px 10px 2px 82px; opacity:.92; transition:opacity .5s ease;"
            >
              <span style="color:#5b7077;">emits</span> <span style="color:#E7C9A0;">OrderPlaced</span>
            </div>
            <div
              data-kind="commit"
              data-delay="1600"
              style="padding:2px 10px 2px 58px; border-left:2px solid rgba(34,211,238,0.55); background:rgba(34,211,238,0.05); opacity:1; transition:opacity .5s ease, border-color .5s ease, background .5s ease;"
            >
              <span style="color:#22D3EE;">event</span>
              <span style="color:#E7C9A0;">OrderPlaced</span>
            </div>
            <div
              data-kind="reveal"
              data-delay="1800"
              style="padding:2px 10px 2px 82px; opacity:.92; transition:opacity .5s ease;"
            >
              orderId: <span style="color:#8FD3FF;">UUID</span>
            </div>
            <div
              data-kind="reveal"
              data-delay="1900"
              style="padding:2px 10px 2px 82px; opacity:.92; transition:opacity .5s ease;"
            >
              placedAt: <span style="color:#8FD3FF;">DateTime</span>
            </div>
            <div style="height:10px;"></div>
            <div
              data-kind="commit"
              data-delay="2100"
              style="padding:2px 10px; border-left:2px solid rgba(34,211,238,0.55); background:rgba(34,211,238,0.05); opacity:1; transition:opacity .5s ease, border-color .5s ease, background .5s ease;"
            >
              <span style="color:#22D3EE;">flow</span>
              <span style="color:#9DE6C6;">"order-placed"</span>
            </div>
            <div
              data-kind="reveal"
              data-delay="2250"
              style="padding:2px 10px 2px 34px; opacity:.92; transition:opacity .5s ease;"
            >
              <span style="color:#22D3EE;">moment</span>
              <span style="color:#9DE6C6;">"Submission"</span>
            </div>
            <div
              data-kind="reveal"
              data-delay="2350"
              style="padding:2px 10px 2px 58px; opacity:.92; transition:opacity .5s ease;"
            >
              ordering: OrderPlaced
            </div>
            <div
              data-kind="commit"
              data-delay="2500"
              style="padding:2px 10px 2px 82px; border-left:2px solid rgba(34,211,238,0.55); background:rgba(34,211,238,0.05); opacity:1; transition:opacity .5s ease, border-color .5s ease, background .5s ease;"
            >
              <span style="color:#C58CFF;">crosses-to</span> fulfillment
            </div>
            <div
              data-kind="reveal"
              data-delay="2650"
              style="padding:2px 10px 2px 82px; opacity:.92; transition:opacity .5s ease;"
            >
              <span style="color:#5b7077;">via</span> CustomerSupplier
            </div>
          </div>
        </div>

        {/* CONNECTOR */}
        <div
          style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;"
        >
          <span
            style="font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:.12em; text-transform:uppercase; color:#5b7077;"
            >compiles</span
          >
          <svg width="64" height="24" viewBox="0 0 64 24" fill="none" style="overflow:visible;">
            <line
              x1="2"
              y1="12"
              x2="54"
              y2="12"
              stroke="rgba(34,211,238,0.35)"
              stroke-width="1.4"
              stroke-dasharray="5 5"
              style="animation:momDash 1s linear infinite;"></line>
            <path d="M54 6 L62 12 L54 18" stroke="#22D3EE" stroke-width="1.6" fill="none"></path>
            <circle
              cx="2"
              cy="12"
              r="3"
              fill="#22D3EE"
              style="animation:momConvey 1.8s ease-in-out infinite;"></circle>
            <circle
              cx="2"
              cy="12"
              r="3"
              fill="#22D3EE"
              style="animation:momConvey 1.8s ease-in-out .9s infinite;"></circle>
          </svg>
          <span
            style="font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:.04em; color:#22D3EE;"
            >moment&nbsp;build</span
          >
        </div>

        {/* FLOW PANEL */}
        <div
          style="background:#080C11; border:1px solid rgba(34,211,238,0.22); border-radius:14px; overflow:hidden; box-shadow:0 24px 60px rgba(0,0,0,.55);"
        >
          <div
            style="display:flex; align-items:center; justify-content:space-between; padding:13px 16px; border-bottom:1px solid rgba(255,255,255,0.07);"
          >
            <span style="font-family:'JetBrains Mono',monospace; font-size:12.5px; color:#7C8C92;"
              >facet · order-placed</span
            >
            <span
              style="display:flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:11px; color:#7FE9F5;"
              ><span
                style="width:6px;height:6px;border-radius:50%;background:#22D3EE;animation:momPulse 1.4s ease infinite;"
              ></span>rendering</span
            >
          </div>
          <div style="padding:18px 18px 12px;">
            <svg viewBox="0 0 540 300" width="100%" style="display:block;">
              <defs>
                <marker id="haA" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"
                  ><path d="M0,0 L9,4.5 L0,9 Z" fill="#22D3EE"></path></marker
                >
              </defs>
              <g data-kind="draw" data-delay="400" style="opacity:1; transition:opacity .45s ease;">
                <rect
                  x="0"
                  y="18"
                  width="540"
                  height="116"
                  rx="10"
                  fill="rgba(34,211,238,0.05)"
                  stroke="rgba(34,211,238,0.2)"></rect>
                <text
                  x="16"
                  y="40"
                  font-family="JetBrains Mono, monospace"
                  font-size="11.5"
                  fill="#22D3EE">Ordering</text
                >
                <text
                  x="78"
                  y="40"
                  font-family="JetBrains Mono, monospace"
                  font-size="9.5"
                  fill="#5b7077">[Core]</text
                >
              </g>
              <g data-kind="draw" data-delay="750" style="opacity:1; transition:opacity .45s ease;">
                <rect
                  x="0"
                  y="150"
                  width="540"
                  height="116"
                  rx="10"
                  fill="rgba(255,255,255,0.025)"
                  stroke="rgba(255,255,255,0.09)"></rect>
                <text
                  x="16"
                  y="172"
                  font-family="JetBrains Mono, monospace"
                  font-size="11.5"
                  fill="#9aacb3">Fulfillment</text
                >
                <text
                  x="98"
                  y="172"
                  font-family="JetBrains Mono, monospace"
                  font-size="9.5"
                  fill="#5b7077">[Supporting]</text
                >
              </g>
              <g data-kind="draw" data-delay="1200" style="opacity:1; transition:opacity .45s ease;">
                <rect
                  x="44"
                  y="62"
                  width="120"
                  height="36"
                  rx="8"
                  fill="#0d141a"
                  stroke="rgba(34,211,238,0.45)"></rect>
                <text
                  x="104"
                  y="84"
                  text-anchor="middle"
                  font-family="Geist, sans-serif"
                  font-size="12"
                  fill="#cfe9ee">PlaceOrder</text
                >
              </g>
              <line
                data-kind="draw"
                data-delay="1600"
                x1="164"
                y1="80"
                x2="206"
                y2="80"
                stroke="#22D3EE"
                stroke-width="1.6"
                marker-end="url(#haA)"
                style="opacity:1; transition:opacity .45s ease;"></line>
              <g data-kind="draw" data-delay="1600" style="opacity:1; transition:opacity .45s ease;">
                <rect
                  x="210"
                  y="62"
                  width="130"
                  height="36"
                  rx="8"
                  fill="#0d141a"
                  stroke="rgba(34,211,238,0.6)"></rect>
                <text
                  x="275"
                  y="84"
                  text-anchor="middle"
                  font-family="Geist, sans-serif"
                  font-size="12"
                  fill="#9DE6C6">OrderPlaced</text
                >
              </g>
              <g data-kind="draw" data-delay="2500" style="opacity:1; transition:opacity .45s ease;">
                <path
                  d="M340,96 C430,128 410,150 446,178"
                  fill="none"
                  stroke="#22D3EE"
                  stroke-width="1.7"
                  stroke-dasharray="6 6"
                  marker-end="url(#haA)"
                  style="animation:momDash 1s linear infinite;"></path>
                <text
                  x="356"
                  y="126"
                  font-family="JetBrains Mono, monospace"
                  font-size="9.5"
                  fill="#22D3EE">crosses-to · CustomerSupplier</text
                >
                <text
                  x="356"
                  y="139"
                  font-family="JetBrains Mono, monospace"
                  font-size="8.5"
                  fill="#5b7077">contract {'{orderId, items}'}</text
                >
              </g>
              <g data-kind="draw" data-delay="2500" style="opacity:1; transition:opacity .45s ease;">
                <rect
                  x="360"
                  y="190"
                  width="172"
                  height="36"
                  rx="8"
                  fill="#0e1318"
                  stroke="rgba(255,255,255,0.16)"></rect>
                <text
                  x="446"
                  y="212"
                  text-anchor="middle"
                  font-family="Geist, sans-serif"
                  font-size="12"
                  fill="#cdd2da">InitiateFulfillment</text
                >
              </g>
              <circle r="5" fill="#22D3EE" style="filter:drop-shadow(0 0 6px #22D3EE);">
                <animateMotion
                  id="momPulsePath"
                  begin="indefinite"
                  dur="2.6s"
                  repeatCount="indefinite"
                  path="M104,80 L275,80 C430,128 410,150 446,208"></animateMotion>
              </circle>
            </svg>
            <div
              style="display:flex; gap:18px; justify-content:center; margin-top:6px; font-family:'JetBrains Mono',monospace; font-size:10.5px; color:#7C8C92;"
            >
              <span><span style="color:#E7C9A0;">●</span> command</span>
              <span><span style="color:#9DE6C6;">●</span> event</span>
              <span><span style="color:#22D3EE;">⇢</span> crosses boundary</span>
            </div>
          </div>
        </div>
      </div>

      {/* caption + controls */}
      <div
        style="display:flex; align-items:center; justify-content:space-between; margin-top:22px; flex-wrap:wrap; gap:14px;"
      >
        <p style="margin:0; font-size:14px; color:#7C8C92; max-width:620px; line-height:1.55;">
          Every construct you write commits a piece of the flow on the right. <span
            style="color:#C9E8ED;">The diagram is a build artifact of the spec</span
          > — not a drawing you maintain by hand.
        </p>
        <div style="display:flex; align-items:center; gap:14px;">
          <button
            id="momReplay"
            type="button"
            class="btn-replay"
            style="display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace; font-size:12.5px; border-radius:8px; padding:10px 16px;"
          >
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none"
              ><path d="M2 1.5 L10 6 L2 10.5 Z" fill="#22D3EE"></path></svg
            >replay the build
          </button>
          <a
            href="/dsl"
            class="btn-primary"
            style="font-size:15px; font-weight:600; padding:11px 20px; border-radius:8px;"
            >Read the spec →</a
          >
        </div>
      </div>
    </section>

    {/* ECOSYSTEM STRIP */}
    <div
      style="position:relative; border-top:1px solid rgba(255,255,255,0.06); border-bottom:1px solid rgba(255,255,255,0.06); margin-top:40px;"
    >
      <div
        class="site-container"
        style="max-width:1200px; margin:0 auto; padding:14px 40px; display:flex; align-items:center; gap:18px; font-family:'JetBrains Mono',monospace; font-size:12.5px; color:#7C8C92; flex-wrap:wrap;"
      >
        <span style="letter-spacing:.1em; text-transform:uppercase; color:#5b7077;">Part of Complai</span>
        <span style="width:1px; height:16px; background:rgba(255,255,255,0.12);"></span>
        <span>Sift</span><span style="color:#3a4750;">·</span><span style="color:#C9E8ED;">Moment</span
        ><span style="color:#3a4750;">·</span><span>Forge</span><span style="color:#3a4750;">·</span
        ><span>Proof</span><span style="color:#3a4750;">·</span><span>Glean</span><span
          style="color:#3a4750;">·</span
        ><span>Codex</span><span style="color:#3a4750;">·</span><span>Trace</span><span
          style="color:#3a4750;">·</span
        ><span>Facet</span>
        <span style="margin-left:auto; color:#5b7077;">
          the open-source keystone — runs with zero Complai dependency
        </span>
      </div>
    </div>

    {/* THE GAP */}
    <section style="position:relative;">
      <div class="site-container" style="max-width:1200px; margin:0 auto; padding:84px 40px;">
        <div
          style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:16px;"
        >
          The gap nobody instruments
        </div>
        <h2
          style="font-weight:600; font-size:40px; line-height:1.1; letter-spacing:-.02em; margin:0 0 14px; max-width:780px; color:#F2FBFC;"
        >
          In every other discipline you validate the design before you build it. DDD goes straight
          from whiteboard to code.
        </h2>
        <p
          style="font-size:17px; line-height:1.6; color:#90A2AA; max-width:640px; margin:0 0 50px;"
        >
          There has never been a way to simulate event flows, validate crossing contracts, or test
          saga orchestration before writing implementation. The gap between the model you agreed to
          and the code you shipped has never been instrumented — and AI agents now widen it at
          machine speed.
        </p>
        <div
          style="display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.08); border-radius:14px; overflow:hidden;"
        >
          <div style="background:#07090D; padding:34px 30px;">
            <div
              style="font-weight:600; font-size:46px; color:#22D3EE; line-height:1; margin-bottom:18px; letter-spacing:-.02em;"
            >
              0
            </div>
            <div style="font-weight:600; font-size:16.5px; margin-bottom:10px; color:#E6F0F2;">
              Ways to test flows before code
            </div>
            <p style="margin:0; font-size:14px; line-height:1.6; color:#90A2AA;">
              You test commands. You test queries. The temporal flows between bounded contexts go
              straight to production untested.
            </p>
          </div>
          <div style="background:#07090D; padding:34px 30px;">
            <div
              style="font-weight:600; font-size:46px; color:#22D3EE; line-height:1; margin-bottom:18px; letter-spacing:-.02em;"
            >
              6×
            </div>
            <div style="font-weight:600; font-size:16.5px; margin-bottom:10px; color:#E6F0F2;">
              Representations that diverge
            </div>
            <p style="margin:0; font-size:14px; line-height:1.6; color:#90A2AA;">
              Your model lives in the wiki, the types, the tests, the docs, the API spec, and
              someone's head. Six copies that drifted on day two.
            </p>
          </div>
          <div style="background:#07090D; padding:34px 30px;">
            <div
              style="font-weight:600; font-size:46px; color:#22D3EE; line-height:1; margin-bottom:18px; letter-spacing:-.02em;"
            >
              ∞
            </div>
            <div style="font-weight:600; font-size:16.5px; margin-bottom:10px; color:#E6F0F2;">
              The drift compounds silently
            </div>
            <p style="margin:0; font-size:14px; line-height:1.6; color:#90A2AA;">
              Where events cross boundaries, contracts break, and sagas fail — that's the untested
              frontier where incidents are born.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* BEFORE / AFTER */}
    <section style="position:relative; border-top:1px solid rgba(255,255,255,0.06);">
      <div class="site-container" style="max-width:1200px; margin:0 auto; padding:84px 40px;">
        <div
          style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:16px;"
        >
          One source of truth
        </div>
        <h2
          style="font-weight:600; font-size:38px; line-height:1.1; letter-spacing:-.02em; margin:0 0 44px; color:#F2FBFC;"
        >
          One specification replaces seven<br />manually-maintained artifacts.
        </h2>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:22px;">
          <div
            style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:28px 30px;"
          >
            <div
              style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#9a6a6a; letter-spacing:.06em; margin-bottom:20px;"
            >
              WITHOUT MOMENT
            </div>
            <div
              style="display:flex; flex-direction:column; gap:13px; font-family:'JetBrains Mono',monospace; font-size:13px; color:#90A2AA;"
            >
              <div style="display:flex; justify-content:space-between;">
