---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Examples';
const description =
  'Real .moment specs and the Facet flows they render — commerce, a payments orchestration, multi-context onboarding. The diagram is a build artifact of the spec.';
---

<Base title={title} description={description}>
  <div style="position:relative; overflow:hidden;">
    <Nav />

    <div
      style="position:absolute; inset:0; top:0; background-image:linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px); background-size:48px 48px; pointer-events:none;"
    >
    </div>
    <div
      style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:1000px; height:520px; background:radial-gradient(ellipse at center, rgba(34,211,238,0.09), transparent 70%); pointer-events:none;"
    >
    </div>

    <section
      class="site-container"
      style="position:relative; max-width:1000px; margin:0 auto; padding:88px 40px 20px;"
    >
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:22px;"
      >
        Examples
      </div>
      <h1
        style="font-weight:600; font-size:54px; line-height:1.05; letter-spacing:-.025em; margin:0 0 24px; max-width:760px; color:#F2FBFC;"
      >
        Real specs, and the flows they render.
      </h1>
      <p style="font-size:19px; line-height:1.6; color:#90A2AA; max-width:680px; margin:0;">
        Each example is a complete <span
          style="font-family:'JetBrains Mono',monospace;font-size:15.5px;color:#C9E8ED;">.moment</span
        > file beside the Facet flow it compiles into. The diagram is a build artifact of the spec —
        never drawn by hand.
      </p>
    </section>

    {/* EXAMPLE 1 */}
    <section id="ex-ordering" class="site-container" style="position:relative; max-width:1200px; margin:0 auto; padding:56px 40px 20px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
        <span
          style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE;"
          >01 · Commerce</span
        >
        <span style="width:1px; height:14px; background:rgba(255,255,255,0.14);"></span>
        <h2 style="font-weight:600; font-size:24px; letter-spacing:-.01em; margin:0; color:#F2FBFC;">
          Order → Fulfillment crossing
        </h2>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:stretch;">
        <div
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:14px; overflow:hidden;"
        >
          <div
            style="padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:12px; color:#7C8C92;"
          >
            order.moment
          </div>
          <pre
            style="margin:0; padding:20px 18px; font-family:'JetBrains Mono',monospace; font-size:12.5px; line-height:1.8; color:#C2C6D2; overflow:auto;"><span style="color:#22D3EE;">context</span>{' '}<span style="color:#9DE6C6;">"Ordering"</span>{' '}<span style="color:#5b7077;">[Core]</span>{'\n  '}<span style="color:#22D3EE;">aggregate</span>{' '}<span style="color:#9DE6C6;">"Order"</span>{'\n    '}<span style="color:#5b7077;">identity</span>{' orderId: '}<span style="color:#8FD3FF;">UUID</span>{'\n    '}<span style="color:#22D3EE;">command</span>{' '}<span style="color:#E7C9A0;">PlaceOrder</span>{'\n      '}<span style="color:#5b7077;">input</span>{' items: '}<span style="color:#8FD3FF;">LineItem[]</span>{'\n      '}<span style="color:#5b7077;">emits</span>{' '}<span style="color:#E7C9A0;">OrderPlaced</span>{'\n    '}<span style="color:#22D3EE;">event</span>{' '}<span style="color:#E7C9A0;">OrderPlaced</span>{'\n      orderId: '}<span style="color:#8FD3FF;">UUID</span>{'\n      items: '}<span style="color:#8FD3FF;">LineItem[]</span>{'\n  '}<span style="color:#22D3EE;">value-object</span>{' '}<span style="color:#E7C9A0;">LineItem</span>{'\n    sku: '}<span style="color:#8FD3FF;">string</span>{'\n    quantity: '}<span style="color:#8FD3FF;">number</span>{'\n\n'}<span style="color:#22D3EE;">context</span>{' '}<span style="color:#9DE6C6;">"Fulfillment"</span>{' '}<span style="color:#5b7077;">[Supporting]</span>{'\n  '}<span style="color:#22D3EE;">aggregate</span>{' '}<span style="color:#9DE6C6;">"Shipment"</span>{'\n    '}<span style="color:#5b7077;">identity</span>{' shipmentId: '}<span style="color:#8FD3FF;">UUID</span>{'\n    '}<span style="color:#22D3EE;">command</span>{' '}<span style="color:#E7C9A0;">InitiateFulfillment</span>{'\n      '}<span style="color:#5b7077;">input</span>{' orderId: '}<span style="color:#8FD3FF;">UUID</span>{'\n      '}<span style="color:#5b7077;">emits</span>{' '}<span style="color:#E7C9A0;">FulfillmentInitiated</span>{'\n    '}<span style="color:#22D3EE;">event</span>{' '}<span style="color:#E7C9A0;">FulfillmentInitiated</span>{'\n      shipmentId: '}<span style="color:#8FD3FF;">UUID</span>{'\n\n'}<span style="color:#22D3EE;">flow</span>{' '}<span style="color:#9DE6C6;">"order-placed"</span>{'\n  '}<span style="color:#22D3EE;">lane</span>{' ordering '}<span style="color:#9DE6C6;">"Ordering"</span>{' '}<span style="color:#5b7077;">[Core]</span>{'\n  '}<span style="color:#22D3EE;">lane</span>{' fulfillment '}<span style="color:#9DE6C6;">"Fulfillment"</span>{' '}<span style="color:#5b7077;">[Supporting]</span>{'\n  '}<span style="color:#22D3EE;">moment</span>{' '}<span style="color:#9DE6C6;">"Submission"</span>{'\n    ordering: '}<span style="color:#E7C9A0;">OrderPlaced</span>{' '}<span style="color:#C58CFF;">crosses-to</span>{' fulfillment '}<span style="color:#5b7077;">via</span>{' CustomerSupplier\n      '}<span style="color:#5b7077;">contract</span>{'\n        orderId: '}<span style="color:#8FD3FF;">UUID</span>{' '}<span style="color:#5b7077;">[required]</span>{'\n        items: '}<span style="color:#8FD3FF;">LineItem[]</span>{' '}<span style="color:#5b7077;">[required]</span>{'\n      '}<span style="color:#C58CFF;">triggers</span>{' '}<span style="color:#E7C9A0;">InitiateFulfillment</span></pre>
        </div>
        <div
          style="background:#080C11; border:1px solid rgba(34,211,238,0.22); border-radius:14px; overflow:hidden; display:flex; flex-direction:column;"
        >
          <div
            style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07);"
          >
            <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#C9E8ED;"
              >facet · order-placed</span
            >
            <span
              style="display:flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:11px; color:#7fbf9a;"
              ><span
                style="width:6px;height:6px;border-radius:50%;background:#7fbf9a;animation:exPulse 1.8s ease infinite;"
              ></span>1/1 contracts</span
            >
          </div>
          <div style="padding:18px; flex:1; display:flex; align-items:center;">
            <svg viewBox="0 0 500 240" width="100%" style="display:block;">
              <defs
                ><marker id="ex1" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"
                  ><path d="M0,0 L9,4.5 L0,9 Z" fill="#22D3EE"></path></marker
                ></defs
              >
              <rect
                x="0"
                y="14"
                width="500"
                height="94"
                rx="10"
                fill="rgba(34,211,238,0.05)"
                stroke="rgba(34,211,238,0.2)"></rect>
              <text x="14" y="34" font-family="JetBrains Mono, monospace" font-size="11" fill="#22D3EE"
                >Ordering</text
              >
              <rect
                x="0"
                y="132"
                width="500"
                height="94"
                rx="10"
                fill="rgba(255,255,255,0.025)"
                stroke="rgba(255,255,255,0.09)"></rect>
              <text x="14" y="152" font-family="JetBrains Mono, monospace" font-size="11" fill="#9aacb3"
                >Fulfillment</text
              >
              <rect
                x="150"
                y="52"
                width="150"
                height="34"
                rx="8"
                fill="#0d141a"
                stroke="rgba(34,211,238,0.55)"></rect><text
                x="225"
                y="74"
                text-anchor="middle"
                font-family="Geist"
                font-size="12"
                fill="#9DE6C6">OrderPlaced</text
              >
              <path
                d="M300,80 C400,110 360,128 400,168"
                fill="none"
                stroke="#22D3EE"
                stroke-width="1.7"
                stroke-dasharray="6 6"
                marker-end="url(#ex1)"
                style="animation:exDash 1s linear infinite;"></path>
              <text
                x="316"
                y="112"
                font-family="JetBrains Mono, monospace"
                font-size="9"
                fill="#22D3EE">crosses-to · CustomerSupplier</text
              >
              <text
                x="316"
                y="125"
                font-family="JetBrains Mono, monospace"
                font-size="8.5"
                fill="#5b7077">{'{ orderId, items }'}</text
              >
              <rect
                x="316"
                y="180"
                width="168"
                height="34"
                rx="8"
                fill="#0e1318"
                stroke="rgba(255,255,255,0.16)"></rect><text
                x="400"
                y="202"
                text-anchor="middle"
                font-family="Geist"
                font-size="12"
                fill="#cdd2da">InitiateFulfillment</text
              >
            </svg>
          </div>
        </div>
      </div>
    </section>

    {/* EXAMPLE 2 */}
    <section id="ex-payments" class="site-container" style="position:relative; max-width:1200px; margin:0 auto; padding:36px 40px 20px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
        <span
          style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE;"
          >02 · Payments</span
        >
        <span style="width:1px; height:14px; background:rgba(255,255,255,0.14);"></span>
        <h2 style="font-weight:600; font-size:24px; letter-spacing:-.01em; margin:0; color:#F2FBFC;">
          An orchestration with compensation
        </h2>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:stretch;">
        <div
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:14px; overflow:hidden;"
        >
          <div
            style="padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:12px; color:#7C8C92;"
          >
            payment.moment
          </div>
          <pre
            style="margin:0; padding:20px 18px; font-family:'JetBrains Mono',monospace; font-size:12.5px; line-height:1.8; color:#C2C6D2; overflow:auto;"><span style="color:#22D3EE;">context</span>{' '}<span style="color:#9DE6C6;">"Payments"</span>{' '}<span style="color:#5b7077;">[Core]</span>{'\n  '}<span style="color:#22D3EE;">aggregate</span>{' '}<span style="color:#9DE6C6;">"Payment"</span>{'\n    '}<span style="color:#5b7077;">identity</span>{' paymentId: '}<span style="color:#8FD3FF;">UUID</span>{'\n    '}<span style="color:#22D3EE;">command</span>{' '}<span style="color:#E7C9A0;">AuthorizePayment</span>{'\n      '}<span style="color:#5b7077;">input</span>{' amount: '}<span style="color:#8FD3FF;">Money</span>{'\n      '}<span style="color:#5b7077;">emits</span>{' '}<span style="color:#E7C9A0;">PaymentAuthorized</span>{'\n    '}<span style="color:#22D3EE;">command</span>{' '}<span style="color:#E7C9A0;">CapturePayment</span>{'\n      '}<span style="color:#5b7077;">emits</span>{' '}<span style="color:#E7C9A0;">PaymentCaptured</span>{'\n    '}<span style="color:#22D3EE;">command</span>{' '}<span style="color:#E7C9A0;">RefundPayment</span>{'\n      '}<span style="color:#5b7077;">emits</span>{' '}<span style="color:#E7C9A0;">PaymentRefunded</span>{'\n    '}<span style="color:#22D3EE;">event</span>{' '}<span style="color:#E7C9A0;">PaymentAuthorized</span>{'\n      paymentId: '}<span style="color:#8FD3FF;">UUID</span>{'\n    '}<span style="color:#22D3EE;">event</span>{' '}<span style="color:#E7C9A0;">PaymentCaptured</span>{'\n      paymentId: '}<span style="color:#8FD3FF;">UUID</span>{'\n    '}<span style="color:#22D3EE;">event</span>{' '}<span style="color:#E7C9A0;">PaymentRefunded</span>{'\n      paymentId: '}<span style="color:#8FD3FF;">UUID</span>{'\n\n  '}<span style="color:#22D3EE;">orchestration</span>{' '}<span style="color:#E7C9A0;">Settlement</span>{'\n    '}<span style="color:#22D3EE;">command</span>{' '}<span style="color:#E7C9A0;">StartSettlement</span>{'\n      '}<span style="color:#5b7077;">input</span>{' paymentId: '}<span style="color:#8FD3FF;">UUID</span>{'\n    '}<span style="color:#22D3EE;">command</span>{' '}<span style="color:#E7C9A0;">CompleteSettlement</span>{'\n    '}<span style="color:#22D3EE;">command</span>{' '}<span style="color:#E7C9A0;">AbortSettlement</span>{'\n    '}<span style="color:#5b7077;">invoked-by</span>{' '}<span style="color:#E7C9A0;">StartSettlement</span>{'\n    '}<span style="color:#5b7077;">issues</span>{' '}<span style="color:#E7C9A0;">AuthorizePayment</span>{', '}<span style="color:#E7C9A0;">CapturePayment</span>{'\n    '}<span style="color:#5b7077;">states</span>{' Capturing -> Settled '}<span style="color:#5b7077;">on</span>{' CompleteSettlement\n    '}<span style="color:#5b7077;">compensation</span>{' '}<span style="color:#5b7077;">on</span>{' AbortSettlement '}<span style="color:#5b7077;">issues</span>{' '}<span style="color:#E7C9A0;">RefundPayment</span>{'\n    '}<span style="color:#5b7077;">timeout</span>{' P1D\n\n  '}<span style="color:#22D3EE;">policy</span>{' '}<span style="color:#E7C9A0;">CompleteOnCaptured</span>{'\n    '}<span style="color:#5b7077;">trigger</span>{' '}<span style="color:#E7C9A0;">PaymentCaptured</span>{'\n    '}<span style="color:#5b7077;">action</span>{' '}<span style="color:#9DE6C6;">"the payment is captured"</span>{'\n    '}<span style="color:#5b7077;">chains-to</span>{' '}<span style="color:#E7C9A0;">CompleteSettlement</span>{'\n\n'}<span style="color:#22D3EE;">flow</span>{' '}<span style="color:#9DE6C6;">"settlement"</span>{'\n  '}<span style="color:#22D3EE;">lane</span>{' payments '}<span style="color:#9DE6C6;">"Payments"</span>{' '}<span style="color:#5b7077;">[Core]</span>{'\n  '}<span style="color:#22D3EE;">moment</span>{' '}<span style="color:#9DE6C6;">"Authorize"</span>{'\n    payments: '}<span style="color:#E7C9A0;">AuthorizePayment</span>{'\n    payments: '}<span style="color:#E7C9A0;">PaymentAuthorized</span>{'\n  '}<span style="color:#22D3EE;">moment</span>{' '}<span style="color:#9DE6C6;">"Capture or refund"</span>{' '}<span style="color:#5b7077;">[branch]</span>{'\n    '}<span style="color:#22D3EE;">when</span>{' captured\n      payments: '}<span style="color:#E7C9A0;">CapturePayment</span>{'\n      payments: '}<span style="color:#E7C9A0;">PaymentCaptured</span>{' '}<span style="color:#5b7077;">[terminal]</span>{'\n    '}<span style="color:#22D3EE;">when</span>{' declined\n      payments: '}<span style="color:#E7C9A0;">RefundPayment</span>{'\n      payments: '}<span style="color:#E7C9A0;">PaymentRefunded</span>{' '}<span style="color:#5b7077;">[terminal]</span></pre>
        </div>
        <div
          style="background:#080C11; border:1px solid rgba(34,211,238,0.22); border-radius:14px; overflow:hidden; display:flex; flex-direction:column;"
        >
          <div
            style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07);"
          >
            <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#C9E8ED;"
              >facet · settlement</span
            >
            <span
              style="display:flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:11px; color:#7fbf9a;"
              ><span
                style="width:6px;height:6px;border-radius:50%;background:#7fbf9a;animation:exPulse 1.8s ease infinite;"
              ></span>terminal reached</span
            >
          </div>
          <div style="padding:18px; flex:1; display:flex; align-items:center;">
            <svg viewBox="0 0 500 240" width="100%" style="display:block;">
              <defs>
                <marker id="ex2" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"
                  ><path d="M0,0 L9,4.5 L0,9 Z" fill="#22D3EE"></path></marker
                >
                <marker id="ex2b" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"
                  ><path d="M0,0 L9,4.5 L0,9 Z" fill="#e0b25a"></path></marker
                >
              </defs>
              <circle cx="70" cy="120" r="7" fill="#E7C9A0"></circle>
              <text x="70" y="150" text-anchor="middle" font-family="Geist" font-size="11" fill="#cfd2da"
                >Authorized</text
              >
              <line
                x1="80"
                y1="120"
                x2="150"
                y2="120"
                stroke="#22D3EE"
                stroke-width="1.6"
                marker-end="url(#ex2)"></line>
              <rect
                x="152"
                y="102"
                width="120"
                height="36"
                rx="8"
                fill="#0d141a"
                stroke="rgba(34,211,238,0.5)"></rect><text
                x="212"
                y="124"
                text-anchor="middle"
                font-family="Geist"
                font-size="11.5"
                fill="#cfe9ee">CapturePayment</text
              >
              <path
                d="M272,112 L360,70"
                stroke="#22D3EE"
                stroke-width="1.6"
                marker-end="url(#ex2)"></path>
              <path
                d="M272,130 L360,178"
                stroke="#e0b25a"
                stroke-width="1.6"
                stroke-dasharray="5 5"
                marker-end="url(#ex2b)"></path>
              <circle cx="372" cy="64" r="7" fill="#7fbf9a"></circle>
              <text x="386" y="68" font-family="Geist" font-size="11" fill="#7fbf9a"
                >PaymentCaptured</text
              >
              <circle cx="372" cy="184" r="7" fill="#e0b25a"></circle>
              <text x="386" y="188" font-family="Geist" font-size="11" fill="#e0b25a"
                >PaymentRefunded</text
              >
              <text
                x="360"
                y="120"
                font-family="JetBrains Mono, monospace"
                font-size="9"
                fill="#5b7077">either branch is terminal</text
              >
            </svg>
          </div>
        </div>
      </div>
    </section>

    {/* EXAMPLE 3 */}
    <section id="ex-onboarding" class="site-container" style="position:relative; max-width:1200px; margin:0 auto; padding:36px 40px 20px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
        <span
          style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE;"
          >03 · Onboarding</span
        >
        <span style="width:1px; height:14px; background:rgba(255,255,255,0.14);"></span>
        <h2 style="font-weight:600; font-size:24px; letter-spacing:-.01em; margin:0; color:#F2FBFC;">
          A crossing across three contexts
        </h2>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:stretch;">
        <div
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:14px; overflow:hidden;"
        >
          <div
            style="padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:12px; color:#7C8C92;"
          >
            onboarding.moment
          </div>
