---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MomentCode from '../components/MomentCode.astro';
import { FACET_URL, TICKETWAVE_BOARD_URL, TICKETWAVE_SPEC_URL } from '../consts';
import ticketwaveN5 from '../snippets/ticketwave-n5.moment?raw';
import orderExample from '../snippets/example-order.moment?raw';
import paymentExample from '../snippets/example-payment.moment?raw';
import onboardingExample from '../snippets/example-onboarding.moment?raw';

const title = 'Examples';
const description =
  'Real .moment models and the flows they describe: TicketWave, a ticketing platform rehearsed in Facet, plus commerce, a payments orchestration and onboarding across three contexts.';

const n5Scenarios = [
  { name: 'Happy Path: N5 - Seat request', kind: 'happy', events: 5 },
  { name: 'Variant: N5 - Seat request [sold-out]', kind: 'variant', events: 5 },
  { name: 'Failure: Requested quantity must be available in the pool not met', kind: 'negative', events: 2 },
  { name: 'Failure: Customer must not exceed maximum concurrent holds not met', kind: 'negative', events: 2 },
  { name: 'Failure: Customer must not already be on the waitlist for this tier not met', kind: 'negative', events: 5 },
];
---

<Base title={title} description={description}>
  <div style="position:relative; overflow:hidden;">
    <Nav />

    <div
      style="position:absolute; inset:0; top:0; background-image:linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px); background-size:48px 48px; pointer-events:none;"
    >
    </div>
    <div
      style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:1000px; height:520px; background:radial-gradient(ellipse at center, rgba(34,211,238,0.09), transparent 70%); pointer-events:none;"
    >
    </div>

    <section
      class="site-container"
      style="position:relative; max-width:1000px; margin:0 auto; padding:88px 40px 20px;"
    >
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:22px;"
      >
        Examples
      </div>
      <h1
        style="font-weight:600; font-size:54px; line-height:1.05; letter-spacing:-.025em; margin:0 0 24px; max-width:760px; color:#F2FBFC;"
      >
        Real models, and the flows they describe.
      </h1>
      <p style="font-size:19px; line-height:1.6; color:#90A2AA; max-width:680px; margin:0;">
        Each example is a complete <span
          style="font-family:'JetBrains Mono',monospace;font-size:15.5px;color:#C9E8ED;">.moment</span
        > file beside the flow it describes. Every snippet on this page parses with <span
          style="font-family:'JetBrains Mono',monospace;font-size:15.5px;color:#C9E8ED;">moment parse</span
        >.
      </p>
    </section>

    {/* TICKETWAVE */}
    <section id="ex-ticketwave" class="site-container" style="position:relative; max-width:1200px; margin:0 auto; padding:56px 40px 20px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px; flex-wrap:wrap;">
        <span
          style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE;"
          >01 · TicketWave</span
        >
        <span style="width:1px; height:14px; background:rgba(255,255,255,0.14);"></span>
        <h2 style="font-weight:600; font-size:24px; letter-spacing:-.01em; margin:0; color:#F2FBFC;">
          A ticketing platform, end to end
        </h2>
      </div>
      <p style="font-size:15.5px; line-height:1.6; color:#90A2AA; max-width:760px; margin:0 0 20px;">
        Seven bounded contexts (Catalog, Inventory, Checkout, Presale, Delivery, AntiFraud,
        Notifications), sixteen aggregates, and eight flows from "N1 - General admission purchase"
        to "N8 - Waitlist offer". <span
          style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9E8ED;"
          >moment simulate --all</span
        > derives 72 scenarios: 8 happy, 4 variant, 10 failure, 48 negative and 2 timeout. Below is
        flow N5 and the five scenarios Moment derives from it.
      </p>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:stretch;">
        <div
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:14px; overflow:hidden;"
        >
          <div
            style="padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:12px; color:#7C8C92;"
          >
            ticketwave.moment · N5 - Seat request
          </div>
          <MomentCode code={ticketwaveN5} />
        </div>
        <div
          style="background:#080C11; border:1px solid rgba(34,211,238,0.22); border-radius:14px; overflow:hidden; display:flex; flex-direction:column;"
        >
          <div
            style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07);"
          >
            <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#C9E8ED;"
              >moment simulate --all · N5</span
            >
            <span
              style="display:flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:11px; color:#7fbf9a;"
              ><span
                style="width:6px;height:6px;border-radius:50%;background:#7fbf9a;animation:exPulse 1.8s ease infinite;"
              ></span>5 scenarios</span
            >
          </div>
          <div style="padding:6px 0; flex:1;">
            {
              n5Scenarios.map((sc, i) => (
                <div
                  style={`display:grid; grid-template-columns:1fr 74px 56px; gap:12px; padding:12px 18px; ${i === n5Scenarios.length - 1 ? '' : 'border-bottom:1px solid rgba(255,255,255,0.05);'} font-family:'JetBrains Mono',monospace; font-size:11.5px; line-height:1.5; align-items:start;`}
                >
                  <span style="color:#C2C6D2;">{sc.name}</span>
                  <span style={`color:${sc.kind === 'negative' ? '#e0b25a' : '#7fbf9a'};`}>{sc.kind}</span>
                  <span style="color:#7C8C92; text-align:right;">{sc.events} events</span>
                </div>
              ))
            }
          </div>
          <div
            style="padding:14px 18px; border-top:1px solid rgba(255,255,255,0.07); font-size:13px; line-height:1.55; color:#90A2AA;"
          >
            Nobody wrote the three negative scenarios. Each comes from a precondition of a command
            the flow places.
          </div>
        </div>
      </div>
      <div style="display:flex; gap:14px; margin-top:20px; flex-wrap:wrap;">
        <a
          href={TICKETWAVE_SPEC_URL}
          target="_blank"
          rel="noopener"
          class="btn-primary"
          style="font-size:14px; font-weight:600; padding:11px 20px; border-radius:8px;"
          >The model on GitHub →</a
        >
        <a
          href={TICKETWAVE_BOARD_URL}
          target="_blank"
          rel="noopener"
          class="btn-secondary"
          style="font-size:14px; font-weight:500; padding:11px 18px; border-radius:8px;"
          >The board in Miro →</a
        >
        <a
          href={FACET_URL}
          target="_blank"
          rel="noopener"
          class="btn-secondary"
          style="font-size:14px; font-weight:500; padding:11px 18px; border-radius:8px;"
          >Run the scenarios in Facet →</a
        >
      </div>
    </section>

    {/* EXAMPLE 1 */}
    <section id="ex-ordering" class="site-container" style="position:relative; max-width:1200px; margin:0 auto; padding:36px 40px 20px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
        <span
          style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE;"
          >02 · Commerce</span
        >
        <span style="width:1px; height:14px; background:rgba(255,255,255,0.14);"></span>
        <h2 style="font-weight:600; font-size:24px; letter-spacing:-.01em; margin:0; color:#F2FBFC;">
          Order → Fulfillment crossing
        </h2>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:stretch;">
        <div
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:14px; overflow:hidden;"
        >
          <div
            style="padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:12px; color:#7C8C92;"
          >
            order.moment
          </div>
          <MomentCode code={orderExample} />
        </div>
        <div
          style="background:#080C11; border:1px solid rgba(34,211,238,0.22); border-radius:14px; overflow:hidden; display:flex; flex-direction:column;"
        >
          <div
            style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07);"
          >
            <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#C9E8ED;"
              >facet · order-placed</span
            >
            <span
              style="display:flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:11px; color:#7fbf9a;"
              ><span
                style="width:6px;height:6px;border-radius:50%;background:#7fbf9a;animation:exPulse 1.8s ease infinite;"
              ></span>1/1 contracts</span
            >
          </div>
          <div style="padding:18px; flex:1; display:flex; align-items:center;">
            <svg viewBox="0 0 500 240" width="100%" style="display:block;">
              <defs
                ><marker id="ex1" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"
                  ><path d="M0,0 L9,4.5 L0,9 Z" fill="#22D3EE"></path></marker
                ></defs
              >
              <rect
                x="0"
                y="14"
                width="500"
                height="94"
                rx="10"
                fill="rgba(34,211,238,0.05)"
                stroke="rgba(34,211,238,0.2)"></rect>
              <text x="14" y="34" font-family="JetBrains Mono, monospace" font-size="11" fill="#22D3EE"
                >Ordering</text
              >
              <rect
                x="0"
                y="132"
                width="500"
                height="94"
                rx="10"
                fill="rgba(255,255,255,0.025)"
                stroke="rgba(255,255,255,0.09)"></rect>
              <text x="14" y="152" font-family="JetBrains Mono, monospace" font-size="11" fill="#9aacb3"
                >Fulfillment</text
              >
              <rect
                x="150"
                y="52"
                width="150"
                height="34"
                rx="8"
                fill="#0d141a"
                stroke="rgba(34,211,238,0.55)"></rect><text
                x="225"
                y="74"
                text-anchor="middle"
                font-family="Geist"
                font-size="12"
                fill="#9DE6C6">OrderPlaced</text
              >
              <path
                d="M300,80 C400,110 360,128 400,168"
                fill="none"
                stroke="#22D3EE"
                stroke-width="1.7"
                stroke-dasharray="6 6"
                marker-end="url(#ex1)"
                style="animation:exDash 1s linear infinite;"></path>
              <text
                x="316"
                y="112"
                font-family="JetBrains Mono, monospace"
                font-size="9"
                fill="#22D3EE">crosses-to · CustomerSupplier</text
              >
              <text
                x="316"
                y="125"
                font-family="JetBrains Mono, monospace"
                font-size="8.5"
                fill="#5b7077">{'{ orderId, items }'}</text
              >
              <rect
                x="316"
                y="180"
                width="168"
                height="34"
                rx="8"
                fill="#0e1318"
                stroke="rgba(255,255,255,0.16)"></rect><text
                x="400"
                y="202"
                text-anchor="middle"
                font-family="Geist"
                font-size="12"
                fill="#cdd2da">InitiateFulfillment</text
              >
            </svg>
          </div>
        </div>
      </div>
    </section>

    {/* EXAMPLE 2 */}
    <section id="ex-payments" class="site-container" style="position:relative; max-width:1200px; margin:0 auto; padding:36px 40px 20px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
        <span
          style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE;"
          >03 · Payments</span
        >
        <span style="width:1px; height:14px; background:rgba(255,255,255,0.14);"></span>
        <h2 style="font-weight:600; font-size:24px; letter-spacing:-.01em; margin:0; color:#F2FBFC;">
          An orchestration with compensation
        </h2>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:stretch;">
        <div
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:14px; overflow:hidden;"
        >
          <div
            style="padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:12px; color:#7C8C92;"
          >
            payment.moment
          </div>
          <MomentCode code={paymentExample} />
        </div>
        <div
          style="background:#080C11; border:1px solid rgba(34,211,238,0.22); border-radius:14px; overflow:hidden; display:flex; flex-direction:column;"
        >
          <div
            style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07);"
          >
            <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#C9E8ED;"
              >facet · settlement</span
            >
            <span
              style="display:flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:11px; color:#7fbf9a;"
              ><span
                style="width:6px;height:6px;border-radius:50%;background:#7fbf9a;animation:exPulse 1.8s ease infinite;"
              ></span>2 arms derived</span
            >
          </div>
          <div style="padding:18px; flex:1; display:flex; align-items:center;">
            <svg viewBox="0 0 500 240" width="100%" style="display:block;">
              <defs>
                <marker id="ex2" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"
                  ><path d="M0,0 L9,4.5 L0,9 Z" fill="#22D3EE"></path></marker
                >
                <marker id="ex2b" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"
                  ><path d="M0,0 L9,4.5 L0,9 Z" fill="#e0b25a"></path></marker
                >
              </defs>
              <circle cx="70" cy="120" r="7" fill="#E7C9A0"></circle>
              <text x="70" y="150" text-anchor="middle" font-family="Geist" font-size="11" fill="#cfd2da"
                >Authorized</text
              >
              <line
                x1="80"
                y1="120"
                x2="150"
                y2="120"
                stroke="#22D3EE"
                stroke-width="1.6"
                marker-end="url(#ex2)"></line>
              <rect
                x="152"
                y="102"
                width="120"
                height="36"
                rx="8"
                fill="#0d141a"
                stroke="rgba(34,211,238,0.5)"></rect><text
                x="212"
                y="124"
                text-anchor="middle"
                font-family="Geist"
                font-size="11.5"
                fill="#cfe9ee">CapturePayment</text
              >
              <path
                d="M272,112 L360,70"
                stroke="#22D3EE"
                stroke-width="1.6"
                marker-end="url(#ex2)"></path>
              <path
                d="M272,130 L360,178"
                stroke="#e0b25a"
                stroke-width="1.6"
                stroke-dasharray="5 5"
                marker-end="url(#ex2b)"></path>
              <circle cx="372" cy="64" r="7" fill="#7fbf9a"></circle>
              <text x="386" y="68" font-family="Geist" font-size="11" fill="#7fbf9a"
                >PaymentCaptured</text
              >
              <circle cx="372" cy="184" r="7" fill="#e0b25a"></circle>
              <text x="386" y="188" font-family="Geist" font-size="11" fill="#e0b25a"
                >PaymentRefunded</text
              >
              <text
                x="360"
                y="120"
                font-family="JetBrains Mono, monospace"
                font-size="9"
                fill="#5b7077">refund ends as an outcome</text
              >
            </svg>
          </div>
        </div>
      </div>
    </section>

    {/* EXAMPLE 3 */}
    <section id="ex-onboarding" class="site-container" style="position:relative; max-width:1200px; margin:0 auto; padding:36px 40px 20px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
        <span
          style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE;"
          >04 · Onboarding</span
        >
        <span style="width:1px; height:14px; background:rgba(255,255,255,0.14);"></span>
        <h2 style="font-weight:600; font-size:24px; letter-spacing:-.01em; margin:0; color:#F2FBFC;">
          A crossing across three contexts
        </h2>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:stretch;">
        <div
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:14px; overflow:hidden;"
        >
          <div
            style="padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:12px; color:#7C8C92;"
          >
            onboarding.moment
          </div>
          <MomentCode code={onboardingExample} />
        </div>
        <div
          style="background:#080C11; border:1px solid rgba(34,211,238,0.22); border-radius:14px; overflow:hidden; display:flex; flex-direction:column;"
        >
          <div
            style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.07);"
          >
            <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#C9E8ED;"
              >facet · customer-onboarding</span
            >
            <span
              style="display:flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:11px; color:#7fbf9a;"
              ><span
                style="width:6px;height:6px;border-radius:50%;background:#7fbf9a;animation:exPulse 1.8s ease infinite;"
              ></span>2 crossings ok</span
            >
          </div>
          <div style="padding:18px; flex:1; display:flex; align-items:center;">
            <svg viewBox="0 0 500 240" width="100%" style="display:block;">
              <defs
                ><marker id="ex3" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"
                  ><path d="M0,0 L9,4.5 L0,9 Z" fill="#22D3EE"></path></marker
                ></defs
              >
              <rect
                x="0"
                y="14"
                width="158"
                height="212"
                rx="10"
                fill="rgba(34,211,238,0.05)"
                stroke="rgba(34,211,238,0.18)"></rect>
              <rect
                x="171"
                y="14"
                width="158"
                height="212"
                rx="10"
                fill="rgba(255,255,255,0.025)"
                stroke="rgba(255,255,255,0.08)"></rect>
              <rect
                x="342"
                y="14"
                width="158"
                height="212"
                rx="10"
                fill="rgba(255,255,255,0.025)"
                stroke="rgba(255,255,255,0.08)"></rect>
              <text x="14" y="32" font-family="JetBrains Mono, monospace" font-size="10" fill="#22D3EE"
                >Identity</text
              >
              <text x="185" y="32" font-family="JetBrains Mono, monospace" font-size="10" fill="#9aacb3"
                >Billing</text
              >
              <text x="356" y="32" font-family="JetBrains Mono, monospace" font-size="10" fill="#9aacb3"
                >Workspace</text
              >
              <circle cx="40" cy="90" r="6" fill="#E7C9A0"></circle>
              <text x="52" y="94" font-family="Geist" font-size="10.5" fill="#cfd2da">AccountCreated</text>
              <path
                d="M60,96 C130,120 130,120 200,140"
                fill="none"
                stroke="#22D3EE"
                stroke-width="1.5"
                stroke-dasharray="5 5"
                marker-end="url(#ex3)"
                style="animation:exDash 1s linear infinite;"></path>
              <circle cx="205" cy="146" r="6" fill="#E7C9A0"></circle>
              <text
                x="196"
                y="140"
                text-anchor="end"
                font-family="Geist"
                font-size="10.5"
                fill="#cfd2da">SubStarted</text
              >
              <path
                d="M228,150 C300,168 300,168 372,176"
                fill="none"
                stroke="#22D3EE"
                stroke-width="1.5"
                stroke-dasharray="5 5"
                marker-end="url(#ex3)"
                style="animation:exDash 1s linear infinite;"></path>
              <rect
                x="360"
                y="176"
                width="128"
                height="32"
                rx="8"
                fill="#0d141a"
                stroke="rgba(34,211,238,0.5)"></rect><text
                x="424"
                y="196"
                text-anchor="middle"
                font-family="Geist"
                font-size="10.5"
                fill="#cfe9ee">ProvisionWS</text
              >
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section
      style="position:relative; border-top:1px solid rgba(255,255,255,0.06); margin-top:40px;"
    >
      <div class="site-container" style="max-width:1000px; margin:0 auto; padding:80px 40px; text-align:center;">
        <h2
          style="font-weight:600; font-size:38px; line-height:1.1; letter-spacing:-.02em; margin:0 0 16px; color:#F2FBFC;"
        >
          Write your own.
        </h2>
        <p style="font-size:17px; line-height:1.6; color:#90A2AA; max-width:540px; margin:0 auto 32px;">
          Every one of these is a plain <span
            style="font-family:'JetBrains Mono',monospace;font-size:14px;color:#C9E8ED;">.moment</span
          > file. Install the CLI and check your first model with <span
            style="font-family:'JetBrains Mono',monospace;font-size:14px;color:#C9E8ED;">moment parse</span
          >.
        </p>
        <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
          <a
            href="/get-started"
            class="btn-primary"
            style="font-size:15px; font-weight:600; padding:13px 26px; border-radius:8px;"
            >Get started</a
          >
          <a
            href="/dsl"
            class="btn-secondary"
            style="font-size:15px; font-weight:500; padding:13px 24px; border-radius:8px;"
            >Learn the DSL →</a
          >
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Base>
