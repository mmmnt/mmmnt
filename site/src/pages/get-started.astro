---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { GITHUB_WIKI_URL } from '../consts';

const title = 'Get started';
const description =
  'From an empty folder to a validated flow in five steps. Node 18+ and pnpm are all you need — everything runs locally.';
---

<Base title={title} description={description}>
  <div style="position:relative; overflow:hidden;">
    <Nav active="get-started" />

    <div
      style="position:absolute; inset:0; top:0; background-image:linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px); background-size:48px 48px; pointer-events:none;"
    >
    </div>
    <div
      style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:1000px; height:520px; background:radial-gradient(ellipse at center, rgba(34,211,238,0.09), transparent 70%); pointer-events:none;"
    >
    </div>

    <section
      class="site-container"
      style="position:relative; max-width:1000px; margin:0 auto; padding:88px 40px 20px;"
    >
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:22px;"
      >
        Get started
      </div>
      <h1
        style="font-weight:600; font-size:54px; line-height:1.05; letter-spacing:-.025em; margin:0 0 24px; max-width:720px; color:#F2FBFC;"
      >
        From an empty folder to a validated flow in five steps.
      </h1>
      <p style="font-size:19px; line-height:1.6; color:#90A2AA; max-width:660px; margin:0;">
        Node 18+ and pnpm are all you need. Everything runs locally — no account, no platform. Each
        step links to the repo wiki for deeper reference.
      </p>
    </section>

    <ol
      class="site-container"
      style="position:relative; max-width:1000px; margin:0 auto; padding:56px 40px 20px; display:flex; flex-direction:column; gap:24px; list-style:none;"
    >
      {/* 1 */}
      <li style="display:grid; grid-template-columns:52px 1fr; gap:24px; align-items:start;">
        <div
          aria-hidden="true"
          style="width:52px; height:52px; border-radius:12px; background:rgba(34,211,238,0.1); border:1px solid rgba(34,211,238,0.3); display:flex; align-items:center; justify-content:center; font-family:'JetBrains Mono',monospace; font-size:18px; color:#22D3EE;"
        >
          1
        </div>
        <div>
          <h2 style="font-weight:600; font-size:21px; margin:2px 0 8px; color:#F2FBFC;">
            Install the toolchain
          </h2>
          <p style="font-size:15px; line-height:1.6; color:#90A2AA; margin:0 0 16px; max-width:640px;">
            Clone the monorepo and build all eleven <span
              style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9E8ED;">@mmmnt</span
            > packages. Source-available under FSL-1.1-Apache-2.0.
          </p>
          <div
            style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:12px; overflow:hidden;"
          >
            <div
              style="padding:11px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#7C8C92;"
            >
              terminal
            </div>
            <div
              style="padding:18px 18px; font-family:'JetBrains Mono',monospace; font-size:13px; line-height:1.9; color:#C9E8ED;"
            >
              <div><span style="color:#5b7077;">$</span> git clone https://github.com/mmmnt/moment.git</div>
              <div><span style="color:#5b7077;">$</span> cd moment && pnpm install</div>
              <div><span style="color:#5b7077;">$</span> pnpm turbo build</div>
            </div>
          </div>
        </div>
      </li>

      {/* 2 */}
      <li style="display:grid; grid-template-columns:52px 1fr; gap:24px; align-items:start;">
        <div
          aria-hidden="true"
          style="width:52px; height:52px; border-radius:12px; background:rgba(34,211,238,0.1); border:1px solid rgba(34,211,238,0.3); display:flex; align-items:center; justify-content:center; font-family:'JetBrains Mono',monospace; font-size:18px; color:#22D3EE;"
        >
          2
        </div>
        <div>
          <h2 style="font-weight:600; font-size:21px; margin:2px 0 8px; color:#F2FBFC;">
            Write your first spec
          </h2>
          <p style="font-size:15px; line-height:1.6; color:#90A2AA; margin:0 0 16px; max-width:640px;">
            Create <span style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9E8ED;"
              >order.moment</span
            >. Start with one bounded context, one flow, one crossing — you can grow it later.
          </p>
          <div
            style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:12px; overflow:hidden;"
          >
            <div
              style="padding:11px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#7C8C92;"
            >
              order.moment
            </div>
            <pre
              style="margin:0; padding:18px 18px; font-family:'JetBrains Mono',monospace; font-size:13px; line-height:1.85; color:#C2C6D2; overflow:auto;"><span
                style="color:#22D3EE;">context</span
              > <span style="color:#9DE6C6;">"Ordering"</span> <span style="color:#5b7077;">[Core]</span>{'\n  '}<span
                style="color:#22D3EE;">event</span
              > <span style="color:#E7C9A0;">OrderPlaced</span>{'\n    orderId: '}<span
                style="color:#8FD3FF;">UUID</span
              >{'\n\n'}<span style="color:#22D3EE;">flow</span> <span style="color:#9DE6C6;">"order-placed"</span
              >{'\n  '}<span style="color:#22D3EE;">moment</span> <span style="color:#9DE6C6;">"Submission"</span
              >{'\n    ordering: '}<span style="color:#E7C9A0;">OrderPlaced</span>{'\n      '}<span
                style="color:#C58CFF;">crosses-to</span
              >{' fulfillment\n        '}<span style="color:#5b7077;">contract</span>{' { orderId }'}</pre>
          </div>
        </div>
      </li>

      {/* 3 */}
      <li style="display:grid; grid-template-columns:52px 1fr; gap:24px; align-items:start;">
        <div
          aria-hidden="true"
          style="width:52px; height:52px; border-radius:12px; background:rgba(34,211,238,0.1); border:1px solid rgba(34,211,238,0.3); display:flex; align-items:center; justify-content:center; font-family:'JetBrains Mono',monospace; font-size:18px; color:#22D3EE;"
        >
          3
        </div>
        <div>
          <h2 style="font-weight:600; font-size:21px; margin:2px 0 8px; color:#F2FBFC;">
            Generate every artifact
          </h2>
          <p style="font-size:15px; line-height:1.6; color:#90A2AA; margin:0 0 16px; max-width:640px;">
            Parse, derive scenarios, and emit typed code, tests, docs, and contracts —
            deterministically.
          </p>
          <div
            style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:12px; overflow:hidden;"
          >
            <div
              style="padding:11px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#7C8C92;"
            >
              terminal
            </div>
            <div
              style="padding:18px 18px; font-family:'JetBrains Mono',monospace; font-size:13px; line-height:1.9; color:#C9E8ED;"
            >
              <div>
                <span style="color:#5b7077;">$</span> moment parse <span style="color:#9DE6C6;"
                  >order.moment</span
                >
              </div>
              <div><span style="color:#5b7077;">$</span> moment derive</div>
              <div>
                <span style="color:#5b7077;">$</span> moment generate <span style="color:#22D3EE;"
                  >--all</span
                >
              </div>
              <div style="color:#7fbf9a;">✓ 6 artifacts written · 0 drift</div>
            </div>
          </div>
        </div>
      </li>

      {/* 4 */}
      <li style="display:grid; grid-template-columns:52px 1fr; gap:24px; align-items:start;">
        <div
          aria-hidden="true"
          style="width:52px; height:52px; border-radius:12px; background:rgba(34,211,238,0.1); border:1px solid rgba(34,211,238,0.3); display:flex; align-items:center; justify-content:center; font-family:'JetBrains Mono',monospace; font-size:18px; color:#22D3EE;"
        >
          4
        </div>
        <div>
          <h2 style="font-weight:600; font-size:21px; margin:2px 0 8px; color:#F2FBFC;">
            Simulate before you implement
          </h2>
          <p style="font-size:15px; line-height:1.6; color:#90A2AA; margin:0 0 16px; max-width:640px;">
            <span style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9E8ED;"
              >moment simulate</span
            > is free and local. It produces the <span
              style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9E8ED;">facet.json</span
            > scenario that loads straight into Facet, where the sequence is visualized and every crossing
            contract is asserted.
          </p>
          <div
            style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:12px; overflow:hidden;"
          >
            <div
              style="padding:11px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#7C8C92;"
            >
              terminal
            </div>
            <div
              style="padding:18px 18px; font-family:'JetBrains Mono',monospace; font-size:13px; line-height:1.9; color:#C9E8ED;"
            >
              <div>
                <span style="color:#5b7077;">$</span> moment simulate <span style="color:#22D3EE;"
                  >--out</span
                > facet.json
              </div>
              <div>
                <span style="color:#5b7077;">$</span> moment viz <span style="color:#22D3EE;"
                  >--bridge</span
                >
              </div>
              <div style="color:#7fbf9a;">✓ live at localhost:5173 · 12/12 contracts pass</div>
            </div>
          </div>
        </div>
      </li>

      {/* 5 */}
      <li style="display:grid; grid-template-columns:52px 1fr; gap:24px; align-items:start;">
        <div
          aria-hidden="true"
          style="width:52px; height:52px; border-radius:12px; background:rgba(34,211,238,0.1); border:1px solid rgba(34,211,238,0.3); display:flex; align-items:center; justify-content:center; font-family:'JetBrains Mono',monospace; font-size:18px; color:#22D3EE;"
        >
          5
        </div>
        <div>
          <h2 style="font-weight:600; font-size:21px; margin:2px 0 8px; color:#F2FBFC;">
            Keep spec and code in sync
          </h2>
          <p style="font-size:15px; line-height:1.6; color:#90A2AA; margin:0 0 16px; max-width:640px;">
            As implementation grows, <span
              style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9E8ED;"
              >moment status</span
            > reports gaps by severity and <span
              style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9E8ED;"
              >moment reconcile</span
            > closes them in either direction. Run it in watch mode or in CI.
          </p>
          <div
            style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:12px; overflow:hidden;"
          >
            <div
              style="padding:11px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#7C8C92;"
            >
              terminal
            </div>
            <div
              style="padding:18px 18px; font-family:'JetBrains Mono',monospace; font-size:13px; line-height:1.9; color:#C9E8ED;"
            >
              <div><span style="color:#5b7077;">$</span> moment status</div>
              <div style="color:#7fbf9a;">
                ✓ 0 ERROR · <span style="color:#e0b25a;">1 WARNING</span> · 3 INFO
              </div>
              <div><span style="color:#5b7077;">$</span> moment watch</div>
            </div>
          </div>
        </div>
      </li>
    </ol>

    <section class="site-container" style="position:relative; max-width:1000px; margin:0 auto; padding:36px 40px 10px;">
      <div
        style="background:linear-gradient(180deg, rgba(34,211,238,0.06), rgba(34,211,238,0.015)); border:1px solid rgba(34,211,238,0.22); border-radius:14px; padding:26px 30px;"
      >
        <div
          style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE; margin-bottom:12px;"
        >
          No lock-in
        </div>
        <p style="margin:0; font-size:15.5px; line-height:1.6; color:#C9CDD6;">
          Everything generated is standard TypeScript, Gherkin, Markdown, and AsyncAPI. The <span
            style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9E8ED;">.moment</span
          > file is the only Moment-specific artifact — stop using Moment tomorrow and your code still
          runs.
        </p>
      </div>
    </section>

    <section class="site-container" style="position:relative; max-width:1000px; margin:0 auto; padding:40px 40px 20px;">
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
        <a
          href="/dsl"
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:22px 22px; display:block;"
        >
          <div style="font-weight:600; font-size:15.5px; color:#E6F0F2; margin-bottom:6px;">
            Learn the DSL →
          </div>
          <p style="margin:0; font-size:13px; line-height:1.55; color:#90A2AA;">
            Every keyword, spoon-fed.
          </p>
        </a>
        <a
          href="/examples"
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:22px 22px; display:block;"
        >
          <div style="font-weight:600; font-size:15.5px; color:#E6F0F2; margin-bottom:6px;">
            See examples →
          </div>
          <p style="margin:0; font-size:13px; line-height:1.55; color:#90A2AA;">
            Real specs rendered into flows.
          </p>
        </a>
        <a
          href={GITHUB_WIKI_URL}
          target="_blank"
          rel="noopener"
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:22px 22px; display:block;"
        >
          <div style="font-weight:600; font-size:15.5px; color:#E6F0F2; margin-bottom:6px;">
            Repo wiki →
          </div>
          <p style="margin:0; font-size:13px; line-height:1.55; color:#90A2AA;">
            Full CLI &amp; grammar reference.
          </p>
        </a>
      </div>
    </section>

    <div style="height:52px;"></div>
    <Footer />
  </div>
</Base>
