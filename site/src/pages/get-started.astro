---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MomentCode from '../components/MomentCode.astro';
import { FACET_URL, GITHUB_WIKI_URL } from '../consts';
import shopModel from '../snippets/shop.moment?raw';

const title = 'Get started';
const description =
  'From an empty folder to a checked, simulated model. Node.js 22 or newer and npm are all you need, and everything runs locally.';

const mono = (text: string) =>
  `<span style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9E8ED;">${text}</span>`;
const facetLink = `<a href="${FACET_URL}" target="_blank" rel="noopener" style="color:#C9E8ED; border-bottom:1px solid rgba(201,232,237,0.3);">Facet</a>`;

type Line = { cmd: string } | { out: string };
const steps: Array<{ title: string; body: string; terminal?: Line[]; file?: string; code?: string }> = [
  {
    title: 'Install the CLI',
    body: `Moment requires Node.js 22 or newer. Add ${mono('@mmmnt/cli')} from npm as a dev dependency. It provides the ${mono('moment')} command. Source-available under FSL-1.1-Apache-2.0.`,
    terminal: [{ cmd: 'npm install --save-dev @mmmnt/cli' }, { cmd: 'npx moment --help' }],
  },
  {
    title: 'Write a first model',
    body: `Two contexts and one flow. An order is placed in Ordering, and ${mono('OrderPlaced')} crosses to Fulfillment under a contract: the fields Fulfillment requires. A policy reacts by reserving stock, and the reservation either succeeds or goes to backorder. Save it as ${mono('model/shop.moment')}.`,
    file: 'model/shop.moment',
    code: shopModel,
  },
  {
    title: 'Check it',
    body: `${mono('moment parse')} loads the directory as one project and holds it to the grammar and the validation rules.`,
    terminal: [
      { cmd: 'npx moment parse model/' },
      { out: 'Parsed project successfully: 1 file(s), 2 context(s), 1 flow(s)' },
    ],
  },
  {
    title: 'Generate from it',
    body: `${mono('moment generate')} writes ${mono('features/n1-checkout.feature')}, a TypeScript aggregate, types and a ${mono('.spec.ts')} scaffold per aggregate, a flow test scaffold, and ${mono('specification.md')}. The Gherkin feature documents the flow. It is not the build step.`,
    terminal: [
      { cmd: 'npx moment generate model/shop.moment' },
      { out: 'Generated: 1 .feature file(s), 3 .spec.ts file(s), 1 document(s)' },
    ],
  },
  {
    title: 'Simulate every path, then prove it in Facet',
    body: `${mono('moment simulate --all')} derives three scenarios: the happy path, the ${mono('outOfStock')} variant, and the failure when ${mono('notYetPlaced')} is not met. ${mono('moment serve')} streams the model to ${facetLink} over WebSocket on ${mono('ws://localhost:4321')}, and serves it again when the file changes.`,
    terminal: [
      { cmd: 'npx moment simulate model/shop.moment --all' },
      { out: 'Generated 3 simulation scenario(s), 10 events' },
      { cmd: 'npx moment serve model/shop.moment --all' },
    ],
  },
  {
    title: 'Emit the contracts and the board',
    body: `${mono('moment schema emit')} writes one closed JSON Schema per event: ${mono('OrderPlaced')}, ${mono('StockReserved')} and ${mono('StockBackordered')}. ${mono('moment board')} projects the model onto an event-storming board, one SVG per frame, plus ${mono('manifest.json')}.`,
    terminal: [
      { cmd: 'npx moment schema emit model/ --out-dir schemas' },
      { cmd: 'npx moment board model/ --out board' },
    ],
  },
  {
    title: 'Keep the model and the code in step',
    body: `As the implementation grows, ${mono('moment status')} reports where the code has drifted from the model, and ${mono('moment sync propose')} records each drift as a proposal in ${mono('.domain/')} for you to accept or reject. Run it locally or in CI.`,
    terminal: [
      { cmd: 'npx moment status model/shop.moment' },
      { cmd: 'npx moment sync propose model/shop.moment' },
    ],
  },
];
---

<Base title={title} description={description}>
  <div style="position:relative; overflow:hidden;">
    <Nav active="get-started" />

    <div
      style="position:absolute; inset:0; top:0; background-image:linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px); background-size:48px 48px; pointer-events:none;"
    >
    </div>
    <div
      style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:1000px; height:520px; background:radial-gradient(ellipse at center, rgba(34,211,238,0.09), transparent 70%); pointer-events:none;"
    >
    </div>

    <section
      class="site-container"
      style="position:relative; max-width:1000px; margin:0 auto; padding:88px 40px 20px;"
    >
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:22px;"
      >
        Get started
      </div>
      <h1
        style="font-weight:600; font-size:54px; line-height:1.05; letter-spacing:-.025em; margin:0 0 24px; max-width:720px; color:#F2FBFC;"
      >
        From an empty folder to a checked, simulated model.
      </h1>
      <p style="font-size:19px; line-height:1.6; color:#90A2AA; max-width:660px; margin:0;">
        Node.js 22 or newer and npm are all you need. Everything runs locally, with no account and no
        platform. The repo wiki has the full reference for each step.
      </p>
    </section>

    <ol
      class="site-container"
      style="position:relative; max-width:1000px; margin:0 auto; padding:56px 40px 20px; display:flex; flex-direction:column; gap:24px; list-style:none;"
    >
      {
        steps.map((step, i) => (
          <li style="display:grid; grid-template-columns:52px 1fr; gap:24px; align-items:start;">
            <div
              aria-hidden="true"
              style="width:52px; height:52px; border-radius:12px; background:rgba(34,211,238,0.1); border:1px solid rgba(34,211,238,0.3); display:flex; align-items:center; justify-content:center; font-family:'JetBrains Mono',monospace; font-size:18px; color:#22D3EE;"
            >
              {i + 1}
            </div>
            <div style="min-width:0;">
              <h2 style="font-weight:600; font-size:21px; margin:2px 0 8px; color:#F2FBFC;">
                {step.title}
              </h2>
              <p
                style="font-size:15px; line-height:1.6; color:#90A2AA; margin:0 0 16px; max-width:640px;"
                set:html={step.body}
              />
              <div style="background:#0A0F14; border:1px solid rgba(255,255,255,0.09); border-radius:12px; overflow:hidden;">
                <div style="padding:11px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#7C8C92;">
                  {step.file ?? 'terminal'}
                </div>
                {step.code ? (
                  <MomentCode code={step.code} fontSize={13} />
                ) : (
                  <div style="padding:18px 18px; font-family:'JetBrains Mono',monospace; font-size:13px; line-height:1.9; color:#C9E8ED;">
                    {(step.terminal ?? []).map((line) =>
                      'cmd' in line ? (
                        <div>
                          <span style="color:#5b7077;">$</span> {line.cmd}
                        </div>
                      ) : (
                        <div style="color:#7fbf9a;">{line.out}</div>
                      ),
                    )}
                  </div>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <section class="site-container" style="position:relative; max-width:1000px; margin:0 auto; padding:36px 40px 10px;">
      <div
        style="background:linear-gradient(180deg, rgba(34,211,238,0.06), rgba(34,211,238,0.015)); border:1px solid rgba(34,211,238,0.22); border-radius:14px; padding:26px 30px;"
      >
        <div
          style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE; margin-bottom:12px;"
        >
          No lock-in
        </div>
        <p style="margin:0; font-size:15.5px; line-height:1.6; color:#C9CDD6;">
          Everything generated is standard TypeScript, Gherkin, Markdown, and AsyncAPI. The <span
            style="font-family:'JetBrains Mono',monospace;font-size:13px;color:#C9E8ED;">.moment</span
          > file is the only Moment-specific artifact. Stop using Moment tomorrow and your code
          still runs.
        </p>
      </div>
    </section>

    <section class="site-container" style="position:relative; max-width:1000px; margin:0 auto; padding:40px 40px 20px;">
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
        <a
          href="/dsl"
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:22px 22px; display:block;"
        >
          <div style="font-weight:600; font-size:15.5px; color:#E6F0F2; margin-bottom:6px;">
            Learn the DSL →
          </div>
          <p style="margin:0; font-size:13px; line-height:1.55; color:#90A2AA;">
            Every keyword, with what it means.
          </p>
        </a>
        <a
          href="/examples"
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:22px 22px; display:block;"
        >
          <div style="font-weight:600; font-size:15.5px; color:#E6F0F2; margin-bottom:6px;">
            See examples →
          </div>
          <p style="margin:0; font-size:13px; line-height:1.55; color:#90A2AA;">
            TicketWave and smaller models.
          </p>
        </a>
        <a
          href={GITHUB_WIKI_URL}
          target="_blank"
          rel="noopener"
          style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:22px 22px; display:block;"
        >
          <div style="font-weight:600; font-size:15.5px; color:#E6F0F2; margin-bottom:6px;">
            Repo wiki →
          </div>
          <p style="margin:0; font-size:13px; line-height:1.55; color:#90A2AA;">
            Full CLI &amp; grammar reference.
          </p>
        </a>
      </div>
    </section>

    <div style="height:52px;"></div>
    <Footer />
  </div>
</Base>
