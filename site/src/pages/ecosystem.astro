---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Wordmark from '../components/Wordmark.astro';

const title = 'Ecosystem';
const description =
  'Moment is the open-source keystone of the Complai ecosystem. Everything else is optional. No @mmmnt package may depend on any Complai service.';

const upstreamCards = [
  { name: 'Sift', tag: 'UPSTREAM', desc: 'Automates Event Storming and hands Moment a converged spec. An optional input — hand-authoring the .moment file is always the primary path.' },
  { name: 'Codex', tag: 'UPSTREAM', desc: 'Versioned regulatory rule packs, consumed through an anti-corruption layer. When no pack is active, Moment behaves exactly as it does open-source.' },
];
const downstreamCards = [
  { name: 'Facet', tag: 'DOWNSTREAM', desc: 'The visual test surface. Renders the sequence from facet.json and asserts every crossing contract before code exists.' },
  { name: 'Forge', tag: 'DOWNSTREAM', desc: "Turns Moment's building-block inventory and flow definitions into work items and execution plans for delivery." },
  { name: 'Proof', tag: 'DOWNSTREAM', desc: 'Evaluates Moment artifacts against governing protocols and audits co-evolution debt for regulated delivery.' },
  { name: 'Glean', tag: 'DOWNSTREAM', desc: 'Learns from every Moment stream — a pure consumer that never sits in the request path.' },
];
---

<Base title={title} description={description}>
  <div style="position:relative; overflow:hidden;">
    <Nav active="ecosystem" />

    <div
      style="position:absolute; inset:0; top:0; background-image:linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px); background-size:48px 48px; pointer-events:none;"
    >
    </div>
    <div
      style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:1000px; height:520px; background:radial-gradient(ellipse at center, rgba(34,211,238,0.09), transparent 70%); pointer-events:none;"
    >
    </div>

    <section
      class="site-container"
      style="position:relative; max-width:1000px; margin:0 auto; padding:88px 40px 20px;"
    >
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:22px;"
      >
        The Complai ecosystem
      </div>
      <h1
        style="font-weight:600; font-size:54px; line-height:1.05; letter-spacing:-.025em; margin:0 0 24px; max-width:800px; color:#F2FBFC;"
      >
        Moment is the open-source keystone. Everything else is optional.
      </h1>
      <p style="font-size:19px; line-height:1.6; color:#90A2AA; max-width:680px; margin:0;">
        Complai is an eight-product platform for delivering software in regulated markets through
        generative AI. Moment sits at the center — and the entire pipeline runs without any of the
        others.
      </p>
    </section>

    <section class="site-container" style="position:relative; max-width:1200px; margin:0 auto; padding:56px 40px;">
      <div
        style="background:linear-gradient(180deg, rgba(34,211,238,0.08), rgba(34,211,238,0.02)); border:1px solid rgba(34,211,238,0.28); border-radius:16px; padding:36px 40px; display:grid; grid-template-columns:auto 1fr; gap:32px; align-items:center;"
      >
        <div
          style="font-family:'JetBrains Mono',monospace; font-size:13px; color:#22D3EE; line-height:1.9; white-space:nowrap;"
        >
          <div style="color:#5b7077;"># the constraint</div>
          <div>import {'{ '}<span style="color:#9DE6C6;">*</span>{' }'}</div>
          <div>&nbsp;&nbsp;from <span style="color:#e07a7a;">"@complai/*"</span></div>
          <div style="color:#e07a7a;">✗ forbidden</div>
        </div>
        <div>
          <div
            style="font-weight:600; font-size:22px; color:#F2FBFC; margin-bottom:10px; letter-spacing:-.01em;"
          >
            No <span style="font-family:'JetBrains Mono',monospace; font-size:18px; color:#C9E8ED;"
              >@mmmnt</span
            > package may depend on any Complai service.
          </div>
          <p style="margin:0; font-size:15.5px; line-height:1.6; color:#90A2AA; max-width:640px;">
            Not at runtime, not at build time. The open-source community uses the full toolchain —
            parse, derive, generate, emit, simulate — without ever knowing Complai exists. Every
            commercial product plugs in <span style="color:#C9E8ED;">around</span> Moment, never inside
            it.
          </p>
        </div>
      </div>
    </section>

    <section class="site-container" style="position:relative; max-width:1200px; margin:0 auto; padding:40px 40px 20px;">
      <div
        style="display:grid; grid-template-columns:1fr auto 1fr auto 1fr; gap:0; align-items:center;"
      >
        <div style="display:flex; flex-direction:column; gap:12px;">
          <div
            style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#5b7077; margin-bottom:2px;"
          >
            Upstream · optional
          </div>
          <div
            style="background:#0A0F14; border:1px solid rgba(255,255,255,0.1); border-radius:11px; padding:14px 16px;"
          >
            <div style="font-weight:600; font-size:15px;">Sift</div>
            <div style="font-size:12px; color:#7C8C92; margin-top:2px;">converged spec in</div>
          </div>
          <div
            style="background:#0A0F14; border:1px solid rgba(255,255,255,0.1); border-radius:11px; padding:14px 16px;"
          >
            <div style="font-weight:600; font-size:15px;">Codex</div>
            <div style="font-size:12px; color:#7C8C92; margin-top:2px;">regulatory rule packs</div>
          </div>
        </div>
        <div
          style="padding:0 18px; font-family:'JetBrains Mono',monospace; color:#22D3EE; font-size:20px;"
        >
          →
        </div>
        <div style="display:flex; flex-direction:column; align-items:center; gap:10px;">
          <div
            style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE;"
          >
            Open-source core
          </div>
          <div
            style="width:100%; background:linear-gradient(180deg, rgba(34,211,238,0.14), rgba(34,211,238,0.03)); border:1px solid rgba(34,211,238,0.4); border-radius:14px; padding:26px 22px; text-align:center; box-shadow:0 20px 50px rgba(0,0,0,.5);"
          >
            <div style="display:flex; justify-content:center;">
              <Wordmark size={26} />
            </div>
            <div style="font-size:12.5px; color:#C9E8ED; margin-top:10px; line-height:1.5;">
              spec · derive · generate<br />emit · simulate
            </div>
          </div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:#5b7077;">
            zero Complai dependency
          </div>
        </div>
        <div
          style="padding:0 18px; font-family:'JetBrains Mono',monospace; color:#22D3EE; font-size:20px;"
        >
          →
        </div>
        <div style="display:flex; flex-direction:column; gap:12px;">
          <div
            style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#5b7077; margin-bottom:2px;"
          >
            Downstream · optional
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            <div
              style="background:#0A0F14; border:1px solid rgba(255,255,255,0.1); border-radius:11px; padding:12px 14px;"
            >
              <div style="font-weight:600; font-size:14px;">Facet</div>
            </div>
            <div
              style="background:#0A0F14; border:1px solid rgba(255,255,255,0.1); border-radius:11px; padding:12px 14px;"
            >
              <div style="font-weight:600; font-size:14px;">Forge</div>
            </div>
            <div
              style="background:#0A0F14; border:1px solid rgba(255,255,255,0.1); border-radius:11px; padding:12px 14px;"
            >
              <div style="font-weight:600; font-size:14px;">Proof</div>
            </div>
            <div
              style="background:#0A0F14; border:1px solid rgba(255,255,255,0.1); border-radius:11px; padding:12px 14px;"
            >
              <div style="font-weight:600; font-size:14px;">Glean</div>
            </div>
          </div>
        </div>
      </div>
      <div
        style="text-align:center; margin-top:22px; font-family:'JetBrains Mono',monospace; font-size:12px; color:#7C8C92;"
      >
        <span style="color:#C58CFF;">Trace</span> spans the whole platform, bidirectionally — Moment owns
        its own cascade response.
      </div>
    </section>

    <section style="position:relative; border-top:1px solid rgba(255,255,255,0.06); margin-top:40px;">
      <div class="site-container" style="max-width:1200px; margin:0 auto; padding:72px 40px;">
        <div
          style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:16px;"
        >
          The eight products
        </div>
        <h2
          style="font-weight:600; font-size:34px; line-height:1.1; letter-spacing:-.02em; margin:0 0 40px; color:#F2FBFC;"
        >
          Each one plugs in around the core.
        </h2>
        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:18px;">
          {
            upstreamCards.map((p) => (
              <div style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:24px 24px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                  <span style="font-weight:600;font-size:16px;">{p.name}</span>
                  <span style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#5b7077;letter-spacing:.06em;">
                    {p.tag}
                  </span>
                </div>
                <p set:html={p.desc.replace('.moment', '<span style="font-family:\'JetBrains Mono\',monospace;font-size:12px;color:#C9E8ED;">.moment</span>')} style="margin:0;font-size:13.5px;line-height:1.55;color:#90A2AA;" />
              </div>
            ))
          }
          <div
            style="background:linear-gradient(180deg, rgba(34,211,238,0.1), rgba(34,211,238,0.02)); border:1px solid rgba(34,211,238,0.3); border-radius:12px; padding:24px 24px;"
          >
            <div
              style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;"
            >
              <span style="font-weight:600;font-size:16px;color:#fff;">Moment</span>
              <span
                style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#22D3EE;letter-spacing:.06em;"
                >CORE · OSS</span
              >
            </div>
            <p style="margin:0;font-size:13.5px;line-height:1.55;color:#C9E8ED;">
              Gives DDD its missing temporal dimension — one spec to typed code, tests, docs, and
              simulation. The only part you actually need.
            </p>
          </div>
          {
            downstreamCards.map((p) => (
              <div style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:24px 24px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                  <span style="font-weight:600;font-size:16px;">{p.name}</span>
                  <span style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#5b7077;letter-spacing:.06em;">
                    {p.tag}
                  </span>
                </div>
                <p
                  set:html={p.desc.replace('facet.json', '<span style="font-family:\'JetBrains Mono\',monospace;font-size:12px;color:#C9E8ED;">facet.json</span>')}
                  style="margin:0;font-size:13.5px;line-height:1.55;color:#90A2AA;"
                />
              </div>
            ))
          }
          <div
            style="background:#0A0F14; border:1px solid rgba(197,140,255,0.22); border-radius:12px; padding:24px 24px;"
          >
            <div
              style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;"
            >
              <span style="font-weight:600;font-size:16px;">Trace</span>
              <span
                style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#C58CFF;letter-spacing:.06em;"
                >BIDIRECTIONAL</span
              >
            </div>
            <p style="margin:0;font-size:13.5px;line-height:1.55;color:#90A2AA;">
              Signals cascades across the platform. Moment listens, but owns its own cascade response —
              it is never externally controlled.
            </p>
          </div>
          <div
            style="border:1px dashed rgba(255,255,255,0.14); border-radius:12px; padding:24px 24px; display:flex; flex-direction:column; justify-content:center;"
          >
            <div style="font-weight:600; font-size:16px; color:#7C8C92; margin-bottom:6px;">
              Start with Moment
            </div>
            <p style="margin:0;font-size:13.5px;line-height:1.55;color:#5b7077;">
              Adopt the open-source core alone. Add the commercial layer only when a regulated program
              needs it.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section style="position:relative; border-top:1px solid rgba(255,255,255,0.06);">
      <div class="site-container" style="max-width:1000px; margin:0 auto; padding:80px 40px; text-align:center;">
        <h2
          style="font-weight:600; font-size:38px; line-height:1.1; letter-spacing:-.02em; margin:0 0 16px; color:#F2FBFC;"
        >
          You only ever need the core.
        </h2>
        <p style="font-size:17px; line-height:1.6; color:#90A2AA; max-width:560px; margin:0 auto 32px;">
          Clone the repo, write a <span
            style="font-family:'JetBrains Mono',monospace;font-size:14px;color:#C9E8ED;">.moment</span
          > file, and run the full pipeline today — no account, no platform, no lock-in.
        </p>
        <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
          <a
            href="/get-started"
            class="btn-primary"
            style="font-size:15px; font-weight:600; padding:13px 26px; border-radius:8px;"
            >Get started</a
          >
          <a
            href="/why"
            class="btn-secondary"
            style="font-size:15px; font-weight:500; padding:13px 24px; border-radius:8px;"
            >Why Moment →</a
          >
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Base>
