---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EcosystemDiagram from '../components/EcosystemDiagram.tsx';
import ecosystem from '../data/ecosystem.json';
---

<Base
  title="Ecosystem"
  description="Discover how Moment fits in the Complai ecosystem alongside Sift and Forge — from domain discovery to production deployment."
>
  <Nav slot="nav" />

  <section class="eco-hero">
    <div class="eco-hero__inner">
      <h1 class="eco-hero__title">The Complai Ecosystem</h1>
      <p class="eco-hero__subtitle">
        Three tools, one event-driven workflow. From domain discovery through temporal modeling
        to production scaffolding &mdash; connected by the <code>ComplaiEventEnvelope</code> format.
      </p>
    </div>
  </section>

  <section class="eco-flow">
    <div class="eco-flow__inner">
      <EcosystemDiagram
        tools={ecosystem.tools}
        dataFlow={ecosystem.dataFlow}
        envelope={ecosystem.envelope}
        client:visible
      />
    </div>
  </section>

  <section class="eco-details">
    <div class="eco-details__inner">
      {
        ecosystem.tools.map((tool) => (
          <article class="eco-detail" id={tool.id}>
            <div class="eco-detail__header">
              <span class="eco-detail__position">{tool.position}</span>
              <h2 class="eco-detail__name" style={`color: var(--color-${tool.id})`}>
                {tool.name}
              </h2>
              <p class="eco-detail__tagline">{tool.tagline}</p>
            </div>
            <p class="eco-detail__desc">{tool.description}</p>

            {tool.events.length > 0 && (
              <div class="eco-detail__events">
                <h3 class="eco-detail__events-title">Published Events</h3>
                <div class="eco-detail__events-grid">
                  {tool.events.map((event) => (
                    <code class="eco-detail__event">{event}</code>
                  ))}
                </div>
              </div>
            )}

            <div class="eco-detail__output">
              <span class="eco-detail__output-label">Output:</span>
              <code>{tool.output}</code>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="eco-envelope">
    <div class="eco-envelope__inner">
      <h2 class="eco-envelope__title">The ComplaiEventEnvelope</h2>
      <p class="eco-envelope__desc">
        Every event flowing between Sift, Moment, and Forge is wrapped in a canonical envelope.
        This shared format enables tools to consume each other's event streams without coupling
        to internal implementation details.
      </p>
      <div class="eco-envelope__schema">
        <div class="eco-envelope__header">
          <span class="eco-envelope__dot eco-envelope__dot--red"></span>
          <span class="eco-envelope__dot eco-envelope__dot--yellow"></span>
          <span class="eco-envelope__dot eco-envelope__dot--green"></span>
          <span class="eco-envelope__header-text">ComplaiEventEnvelope</span>
        </div>
        <div class="eco-envelope__body">
          <pre><code>{`interface ComplaiEventEnvelope {
  eventId: UUID;              // Unique event identifier
  eventType: string;          // Discriminator for payload type
  version: string;            // Schema version (semver)
  productSource: string;      // Originating tool
  sessionId: UUID;            // Modeling session identifier
  causationEventIds: UUID[];  // Events that caused this event
  correlationId: UUID;        // Correlation chain identifier
  timestamp: ISO-8601;        // Event creation timestamp
  payload: object;            // Event-specific data
}`}</code></pre>
        </div>
      </div>

      <div class="eco-envelope__flow-desc">
        <h3 class="eco-envelope__flow-title">How events flow</h3>
        <div class="eco-envelope__flows">
          {
            ecosystem.dataFlow.map((flow) => (
              <div class="eco-envelope__flow-item">
                <div class="eco-envelope__flow-path">
                  <code style={`color: var(--color-${flow.from})`}>{flow.from}</code>
                  <span class="eco-envelope__flow-arrow" aria-hidden="true">&rarr;</span>
                  <code style={`color: var(--color-${flow.to})`}>{flow.to}</code>
                </div>
                <p class="eco-envelope__flow-channel">
                  via <code>{flow.channel}</code>
                </p>
                <p class="eco-envelope__flow-explain">{flow.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .eco-hero {
    padding: var(--space-20) var(--space-6) var(--space-10);
    text-align: center;
  }

  .eco-hero__inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .eco-hero__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-4);
  }

  .eco-hero__subtitle {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    max-width: 40rem;
    margin: 0 auto;
    line-height: var(--leading-relaxed);
  }

  .eco-hero__subtitle code {
    color: var(--color-accent);
    background: var(--color-accent-muted);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }

  .eco-flow {
    padding: var(--space-6);
  }

  .eco-flow__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  /* Tool details */
  .eco-details {
    padding: var(--space-16) var(--space-6);
  }

  .eco-details__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    gap: var(--space-10);
  }

  .eco-detail {
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .eco-detail__header {
    margin-bottom: var(--space-4);
  }

  .eco-detail__position {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    margin-bottom: var(--space-2);
    background: var(--color-surface-raised);
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 100px;
  }

  .eco-detail__name {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-1);
  }

  .eco-detail__tagline {
    color: var(--color-text-tertiary);
    font-weight: var(--weight-medium);
  }

  .eco-detail__desc {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .eco-detail__events {
    margin-bottom: var(--space-4);
  }

  .eco-detail__events-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-3);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .eco-detail__events-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .eco-detail__event {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .eco-detail__output {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .eco-detail__output code {
    color: var(--color-text-secondary);
  }

  /* Envelope */
  .eco-envelope {
    padding: var(--space-16) var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }

  .eco-envelope__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .eco-envelope__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-3);
  }

  .eco-envelope__desc {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 42rem;
    margin-bottom: var(--space-8);
  }

  .eco-envelope__schema {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-10);
    max-width: 40rem;
  }

  .eco-envelope__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .eco-envelope__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .eco-envelope__dot--red { background: #ef4444; }
  .eco-envelope__dot--yellow { background: #eab308; }
  .eco-envelope__dot--green { background: #22c55e; }

  .eco-envelope__header-text {
    margin-left: var(--space-2);
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .eco-envelope__body {
    padding: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.7;
    overflow-x: auto;
  }

  .eco-envelope__body pre {
    margin: 0;
  }

  .eco-envelope__flow-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-6);
  }

  .eco-envelope__flows {
    display: grid;
    gap: var(--space-6);
  }

  .eco-envelope__flow-item {
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .eco-envelope__flow-path {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .eco-envelope__flow-path code {
    text-transform: capitalize;
  }

  .eco-envelope__flow-arrow {
    color: var(--color-text-tertiary);
  }

  .eco-envelope__flow-channel {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-2);
  }

  .eco-envelope__flow-channel code {
    color: var(--color-text-secondary);
  }

  .eco-envelope__flow-explain {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
</style>
