---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Why Moment';
const description =
  'DDD maps the domain in two dimensions; systems run in three. Moment adds the temporal dimension — flows, crossings, and contracts you can specify, simulate, and test before implementation.';
---

<Base title={title} description={description}>
  <div style="position:relative; overflow:hidden;">
    <Nav active="why" />

    <div
      style="position:absolute; inset:0; top:0; background-image:linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px); background-size:48px 48px; pointer-events:none;"
    >
    </div>
    <div
      style="position:absolute; top:0; left:50%; transform:translateX(-50%); width:1000px; height:520px; background:radial-gradient(ellipse at center, rgba(34,211,238,0.09), transparent 70%); pointer-events:none;"
    >
    </div>

    {/* HERO */}
    <section
      class="site-container"
      style="position:relative; max-width:1000px; margin:0 auto; padding:88px 40px 20px;"
    >
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:22px;"
      >
        Why Moment
      </div>
      <h1
        style="font-weight:600; font-size:54px; line-height:1.05; letter-spacing:-.025em; margin:0 0 24px; max-width:820px; color:#F2FBFC;"
      >
        Domain-driven design maps the domain in two dimensions. Systems run in three.
      </h1>
      <p style="font-size:19px; line-height:1.6; color:#90A2AA; max-width:680px; margin:0;">
        Contexts, aggregates, and events give you a static map. But behavior happens over <span
          style="color:#C9E8ED;">time</span
        > — events cross boundaries, sagas orchestrate, contracts are honored or broken. That third
        dimension has never been specified, simulated, or tested before implementation. Moment is the
        layer that closes it.
      </p>
    </section>

    {/* THE GAP */}
    <section class="site-container" style="position:relative; max-width:1200px; margin:0 auto; padding:72px 40px;">
      <div
        style="display:grid; grid-template-columns:1fr 1fr; gap:1px; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.08); border-radius:14px; overflow:hidden;"
      >
        <div style="background:#07090D; padding:40px 38px;">
          <div
            style="font-family:'JetBrains Mono',monospace; font-size:11.5px; letter-spacing:.1em; text-transform:uppercase; color:#9a6a6a; margin-bottom:18px;"
          >
            Every other discipline
          </div>
          <p style="font-size:17px; line-height:1.6; color:#C9CDD6; margin:0 0 18px;">
            Validates the design before building it. Circuits get simulated. Structures get
            stress-modeled. Schemas get migrations tested in staging.
          </p>
          <p style="font-size:15px; line-height:1.6; color:#90A2AA; margin:0;">
            There is a rehearsal step between intent and implementation.
          </p>
        </div>
        <div style="background:#07090D; padding:40px 38px;">
          <div
            style="font-family:'JetBrains Mono',monospace; font-size:11.5px; letter-spacing:.1em; text-transform:uppercase; color:#22D3EE; margin-bottom:18px;"
          >
            Domain-driven design
          </div>
          <p style="font-size:17px; line-height:1.6; color:#C9CDD6; margin:0 0 18px;">
            Goes straight from the whiteboard to the code. The event flows between bounded contexts —
            where incidents are actually born — are written directly into production.
          </p>
          <p style="font-size:15px; line-height:1.6; color:#90A2AA; margin:0;">
            There is no rehearsal. Moment adds it.
          </p>
        </div>
      </div>
    </section>

    {/* 2D VS 3D */}
    <section style="position:relative; border-top:1px solid rgba(255,255,255,0.06);">
      <div class="site-container" style="max-width:1200px; margin:0 auto; padding:84px 40px;">
        <div
          style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:16px;"
        >
          The missing dimension
        </div>
        <h2
          style="font-weight:600; font-size:38px; line-height:1.1; letter-spacing:-.02em; margin:0 0 44px; max-width:720px; color:#F2FBFC;"
        >
          Moment adds time to a two-dimensional domain design.
        </h2>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:22px;">
          <div
            style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:30px 30px;"
          >
            <div
              style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#7C8C92; margin-bottom:18px;"
            >
              2D — the static map (DDD today)
            </div>
            <svg viewBox="0 0 420 200" width="100%" style="display:block; margin-bottom:20px;">
              <rect
                x="20"
                y="30"
                width="170"
                height="140"
                rx="10"
                fill="rgba(255,255,255,0.03)"
                stroke="rgba(255,255,255,0.12)"></rect>
              <rect
                x="230"
                y="30"
                width="170"
                height="140"
                rx="10"
                fill="rgba(255,255,255,0.03)"
                stroke="rgba(255,255,255,0.12)"></rect>
              <text x="34" y="52" font-family="JetBrains Mono, monospace" font-size="11" fill="#90A2AA"
                >Ordering</text
              >
              <text x="244" y="52" font-family="JetBrains Mono, monospace" font-size="11" fill="#90A2AA"
                >Fulfillment</text
              >
              <rect
                x="40"
                y="70"
                width="120"
                height="26"
                rx="6"
                fill="#0d141a"
                stroke="rgba(255,255,255,0.14)"></rect><text
                x="100"
                y="87"
                text-anchor="middle"
                font-family="Geist"
                font-size="11"
                fill="#cdd2da">Order</text
              >
              <rect
                x="40"
                y="110"
                width="120"
                height="26"
                rx="6"
                fill="#0d141a"
                stroke="rgba(255,255,255,0.14)"></rect><text
                x="100"
                y="127"
                text-anchor="middle"
                font-family="Geist"
                font-size="11"
                fill="#cdd2da">LineItem</text
              >
              <rect
                x="250"
                y="70"
                width="120"
                height="26"
                rx="6"
                fill="#0d141a"
                stroke="rgba(255,255,255,0.14)"></rect><text
                x="310"
                y="87"
                text-anchor="middle"
                font-family="Geist"
                font-size="11"
                fill="#cdd2da">Shipment</text
              >
            </svg>
            <p style="font-size:14.5px; line-height:1.6; color:#90A2AA; margin:0;">
              You can see the pieces and where they live. You cannot see what happens when, in what
              order, or what data moves between them.
            </p>
          </div>
          <div
            style="background:linear-gradient(180deg, rgba(34,211,238,0.08), rgba(34,211,238,0.02)); border:1px solid rgba(34,211,238,0.28); border-radius:14px; padding:30px 30px;"
          >
            <div
              style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#22D3EE; margin-bottom:18px;"
            >
              + time — the flow (Moment)
            </div>
            <svg viewBox="0 0 420 200" width="100%" style="display:block; margin-bottom:20px;">
              <defs
                ><marker id="wa" markerWidth="8" markerHeight="8" refX="6.5" refY="4" orient="auto"
                  ><path d="M0,0 L8,4 L0,8 Z" fill="#22D3EE"></path></marker
                ></defs
              >
              <line x1="30" y1="24" x2="30" y2="180" stroke="rgba(34,211,238,0.25)" stroke-width="1"
              ></line>
              <text x="8" y="20" font-family="JetBrains Mono, monospace" font-size="9" fill="#5b7077"
                >t</text
              >
              <rect
                x="60"
                y="34"
                width="120"
                height="26"
                rx="6"
                fill="#0d141a"
                stroke="rgba(34,211,238,0.4)"></rect><text
                x="120"
                y="51"
                text-anchor="middle"
                font-family="Geist"
                font-size="11"
                fill="#cfe9ee">PlaceOrder</text
              >
              <circle cx="72" cy="88" r="4" fill="#9DE6C6"></circle><text
                x="84"
                y="92"
                font-family="Geist"
                font-size="11"
                fill="#9DE6C6">OrderPlaced</text
              >
              <path
                d="M120,100 C210,120 210,130 292,150"
                fill="none"
                stroke="#22D3EE"
                stroke-width="1.6"
                stroke-dasharray="5 5"
                marker-end="url(#wa)"></path>
              <text
                x="150"
                y="120"
                font-family="JetBrains Mono, monospace"
                font-size="9"
                fill="#22D3EE">crosses-to · contract</text
              >
              <rect
                x="240"
                y="140"
                width="150"
                height="26"
                rx="6"
                fill="#0e1318"
                stroke="rgba(255,255,255,0.16)"></rect><text
                x="315"
                y="157"
                text-anchor="middle"
                font-family="Geist"
                font-size="11"
                fill="#cdd2da">InitiateFulfillment</text
              >
            </svg>
            <p style="font-size:14.5px; line-height:1.6; color:#B9CCD1; margin:0;">
              Now the sequence is explicit: which event triggers which, where it crosses a boundary,
              and the exact contract the crossing must carry.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* THE MOMENT — unit of value */}
    <section
      style="position:relative; border-top:1px solid rgba(255,255,255,0.06); background:#0A0F14;"
    >
      <div
        class="site-container"
        style="max-width:1200px; margin:0 auto; padding:72px 40px; display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center;"
      >
        <div>
          <div
            style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:16px;"
          >
            The unit of value
          </div>
          <h2
            style="font-weight:600; font-size:32px; line-height:1.12; letter-spacing:-.02em; margin:0 0 14px; color:#F2FBFC;"
          >
            A <span style="color:#7FE9F5;">moment</span> is a behavioral assertion.
          </h2>
          <p style="font-size:16px; line-height:1.62; color:#90A2AA; margin:0 0 16px;">
            It states when, where, and how an event participates in a cross-context flow — including
            the schema contract the crossing carries. Every crossing must declare its contract
            explicitly.
          </p>
          <p style="font-size:15px; line-height:1.62; color:#90A2AA; margin:0;">
            An implicit crossing is not a shortcut. It is a specification error, and Moment reports
            it as one.
          </p>
        </div>
        <div
          style="font-family:'JetBrains Mono',monospace; font-size:13px; background:#07090D; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:24px 24px; line-height:1.8;"
        >
          <div><span style="color:#22D3EE;">moment</span> <span style="color:#9DE6C6;">"Submission"</span></div>
          <div style="padding-left:22px;">ordering: <span style="color:#E7C9A0;">OrderPlaced</span></div>
          <div style="padding-left:22px;"><span style="color:#C58CFF;">crosses-to</span> fulfillment</div>
          <div style="padding-left:44px;"><span style="color:#5b7077;">via</span> CustomerSupplier</div>
          <div style="padding-left:44px;"><span style="color:#5b7077;">contract</span> {'{ orderId, items }'}</div>
          <div
            style="margin-top:14px; padding-top:14px; border-top:1px solid rgba(255,255,255,0.07); color:#7fbf9a;"
          >
            ✓ contract asserted at the boundary
          </div>
        </div>
      </div>
    </section>

    {/* CONVERGENCE */}
    <section style="position:relative; border-top:1px solid rgba(255,255,255,0.06);">
      <div class="site-container" style="max-width:1200px; margin:0 auto; padding:84px 40px;">
        <div
          style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:16px;"
        >
          Convergence, not correctness
        </div>
        <h2
          style="font-weight:600; font-size:38px; line-height:1.1; letter-spacing:-.02em; margin:0 0 14px; max-width:720px; color:#F2FBFC;"
        >
          Gaps between spec and code are diagnosed by severity — and driven to zero.
        </h2>
        <p style="font-size:17px; line-height:1.6; color:#90A2AA; max-width:640px; margin:0 0 44px;">
          Moment never claims your system is “correct.” It measures the distance between the design
          you agreed to and the code you shipped, and gives you a gate to close it.
        </p>
        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:18px;">
          <div
            style="background:#0A0F14; border:1px solid rgba(224,90,90,0.25); border-radius:12px; padding:26px 26px;"
          >
            <div
              style="font-family:'JetBrains Mono',monospace; font-size:13px; color:#e07a7a; margin-bottom:14px;"
            >
              ERROR
            </div>
            <div style="font-weight:600; font-size:16px; margin-bottom:8px; color:#E6F0F2;">
              Blocks convergence
            </div>
            <p style="margin:0; font-size:14px; line-height:1.55; color:#90A2AA;">
              A crossing with no contract, an event no flow consumes, a saga with no terminal state.
              The gate stays shut.
            </p>
          </div>
          <div
            style="background:#0A0F14; border:1px solid rgba(224,178,90,0.25); border-radius:12px; padding:26px 26px;"
          >
            <div
              style="font-family:'JetBrains Mono',monospace; font-size:13px; color:#e0b25a; margin-bottom:14px;"
            >
              WARNING
            </div>
            <div style="font-weight:600; font-size:16px; margin-bottom:8px; color:#E6F0F2;">
              Advisory
            </div>
            <p style="margin:0; font-size:14px; line-height:1.55; color:#90A2AA;">
              Implementation added a field the spec doesn’t know about. Reconcile in either direction
              when you’re ready.
            </p>
          </div>
          <div
            style="background:#0A0F14; border:1px solid rgba(34,211,238,0.25); border-radius:12px; padding:26px 26px;"
          >
            <div
              style="font-family:'JetBrains Mono',monospace; font-size:13px; color:#22D3EE; margin-bottom:14px;"
            >
              INFO
            </div>
            <div style="font-weight:600; font-size:16px; margin-bottom:8px; color:#E6F0F2;">
              Fitness signal
            </div>
            <p style="margin:0; font-size:14px; line-height:1.55; color:#90A2AA;">
              Coverage, naming drift, unused contracts. Tracked over time so the model stays healthy,
              not just legal.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* INDEPENDENCE */}
    <section style="position:relative; border-top:1px solid rgba(255,255,255,0.06);">
      <div class="site-container" style="max-width:1000px; margin:0 auto; padding:80px 40px; text-align:center;">
        <div
          style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:18px;"
        >
          No lock-in by construction
        </div>
        <h2
          style="font-weight:600; font-size:34px; line-height:1.12; letter-spacing:-.02em; margin:0 auto 16px; max-width:720px; color:#F2FBFC;"
        >
          The full pipeline runs with zero Complai dependency.
        </h2>
        <p style="font-size:17px; line-height:1.6; color:#90A2AA; max-width:640px; margin:0 auto 32px;">
          No <span style="font-family:'JetBrains Mono',monospace;font-size:14px;color:#C9E8ED;"
            >@mmmnt</span
          > package may take a runtime or build-time dependency on any Complai service. The open-source
          community uses the entire toolchain without ever knowing Complai exists. Everything commercial
          plugs in around Moment — never inside it.
        </p>
        <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
          <a
            href="/dsl"
            class="btn-primary"
            style="font-size:15px; font-weight:600; padding:13px 24px; border-radius:8px;"
            >Read the DSL →</a
          >
          <a
            href="/get-started"
            class="btn-secondary"
            style="font-size:15px; font-weight:500; padding:13px 22px; border-radius:8px;">Get started</a
          >
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Base>
