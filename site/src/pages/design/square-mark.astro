---
import DesignStudy from '../../layouts/DesignStudy.astro';
---

<DesignStudy title="Square mark">
  <div style="padding:60px 56px 100px;">
    <div style="max-width:1180px; margin:0 auto 48px;">
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:18px;"
      >
        Moment · square mark
      </div>
      <h1
        style="font-weight:500; font-size:42px; line-height:1.08; letter-spacing:-.025em; margin:0 0 16px; color:#F2FBFC; max-width:780px;"
      >
        A square mark for favicon, app icon, and avatar.
      </h1>
      <p style="font-size:17px; line-height:1.6; color:#90A2AA; max-width:640px; margin:0;">
        The wordmark carries the brand, but places that only accept a square container need one
        distilled glyph. Four options — one for lock-in.
      </p>
    </div>

    <section
      style="max-width:1180px; margin:0 auto 56px; display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.08); border-radius:14px; overflow:hidden;"
    >
      {/* A */}
      <div style="background:#0A0F14; padding:38px 24px; display:flex; flex-direction:column; align-items:center; gap:16px;">
        <div
          style="width:120px; height:120px; border-radius:22px; background:#07090D; border:1px solid rgba(255,255,255,0.1); display:flex; align-items:center; justify-content:center; font-family:'Geist',sans-serif; font-weight:700; font-size:64px; letter-spacing:-.04em; color:#F2FBFC;"
        >
          m<span style="color:#22D3EE;">.</span>
        </div>
        <div style="text-align:center;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#E6F0F2; margin-bottom:5px;">A · m.</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:#7C8C92;">
            lead letter + point · most literal tie
          </div>
        </div>
      </div>
      {/* B — recommended */}
      <div
        style="background:#0A0F14; padding:38px 24px; display:flex; flex-direction:column; align-items:center; gap:16px; box-shadow:inset 0 0 0 1px rgba(34,211,238,0.4);"
      >
        <div
          style="width:120px; height:120px; border-radius:22px; background:#07090D; border:1px solid rgba(34,211,238,0.4); display:flex; align-items:center; justify-content:center; font-family:'Geist',sans-serif; font-weight:700; font-size:64px; letter-spacing:-.04em; color:#F2FBFC;"
        >
          o<span style="color:#22D3EE;">.</span>
        </div>
        <div style="text-align:center;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#22D3EE; margin-bottom:5px;">
            B · o. — recommended
          </div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:#7C8C92;">
            heaviest, most iconic — a circle is a point in time
          </div>
        </div>
      </div>
      {/* C — on cyan */}
      <div style="background:#0A0F14; padding:38px 24px; display:flex; flex-direction:column; align-items:center; gap:16px;">
        <div
          style="width:120px; height:120px; border-radius:22px; background:#22D3EE; display:flex; align-items:center; justify-content:center; font-family:'Geist',sans-serif; font-weight:700; font-size:64px; letter-spacing:-.04em; color:#0A0F14;"
        >
          m<span style="color:#fff;">.</span>
        </div>
        <div style="text-align:center;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#E6F0F2; margin-bottom:5px;">C · m. on cyan</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:#7C8C92;">
            locked · high-contrast app icon
          </div>
        </div>
      </div>
      {/* D — mo. */}
      <div style="background:#0A0F14; padding:38px 24px; display:flex; flex-direction:column; align-items:center; gap:16px;">
        <div
          style="width:120px; height:120px; border-radius:22px; background:#07090D; border:1px solid rgba(255,255,255,0.1); display:flex; align-items:center; justify-content:center; font-family:'Geist',sans-serif; font-weight:700; font-size:52px; letter-spacing:-.04em; color:#F2FBFC;"
        >
          mo<span style="color:#22D3EE;">.</span>
        </div>
        <div style="text-align:center;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#E6F0F2; margin-bottom:5px;">D · mo.</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:#7C8C92;">
            two letters carry the rise into the o
          </div>
        </div>
      </div>
    </section>

    <section style="max-width:1180px; margin:0 auto 32px;">
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#22D3EE; letter-spacing:.08em; margin-bottom:14px;"
      >
        Size proof · Recommended (B) at 64 · 32 · 16px
      </div>
      <div
        style="background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:36px 40px; display:flex; align-items:center; gap:36px;"
      >
        {
          [64, 32, 16].map((size) => (
            <div style="display:flex; flex-direction:column; align-items:center; gap:10px;">
              <div
                style={`width:${size}px; height:${size}px; border-radius:${Math.max(3, size / 5)}px; background:#07090D; border:1px solid rgba(255,255,255,0.14); display:flex; align-items:center; justify-content:center; font-family:'Geist',sans-serif; font-weight:700; font-size:${size * 0.53}px; letter-spacing:-.04em; color:#F2FBFC;`}
              >
                o<span style="color:#22D3EE;">.</span>
              </div>
              <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#7C8C92;">
                {size}px
              </span>
            </div>
          ))
        }
        <div style="width:1px; height:64px; background:rgba(255,255,255,0.08);"></div>
        <div style="display:flex; flex-direction:column; align-items:center; gap:10px;">
          <div
            style="width:64px; height:64px; border-radius:14px; background:#22D3EE; display:flex; align-items:center; justify-content:center; font-family:'Geist',sans-serif; font-weight:700; font-size:34px; letter-spacing:-.04em; color:#0A0F14;"
          >
            o<span style="color:#fff;">.</span>
          </div>
          <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#7C8C92;">on cyan</span>
        </div>
      </div>
    </section>

    <div
      style="max-width:1180px; margin:0 auto; padding:24px 30px; background:linear-gradient(180deg, rgba(34,211,238,0.06), rgba(34,211,238,0.015)); border:1px solid rgba(34,211,238,0.22); border-radius:14px;"
    >
      <p style="margin:0; font-size:14.5px; line-height:1.6; color:#C9CDD6;">
        The point is what keeps the mark unmistakably 'moment' at any size. At 16px the dot stays
        the one constant; below that, drop to the bare letter.
      </p>
    </div>
  </div>
</DesignStudy>
