---
import DesignStudy from '../../layouts/DesignStudy.astro';

const studies = [
  { href: '/design/hero', title: 'Hero (Authored Flow)', desc: 'Homepage variant with animated code→flow showcase.' },
  { href: '/design/logotype-weight-curve', title: 'Logotype · Weight curve', desc: 'The recommended weight ladder for the wordmark, plus variants.' },
  { href: '/design/logotype-studies', title: 'Logotype · Studies', desc: 'Typeface candidates, weight ladders, tracking, and letter treatments.' },
  { href: '/design/square-mark', title: 'Square mark', desc: 'Favicon / app icon / avatar variants.' },
  { href: '/design/logo-explorations', title: 'Logo explorations', desc: 'Six candidate marks for a point-in-time symbol.' },
];
---

<DesignStudy title="Design studies index">
  <main
    class="site-container"
    style="max-width:1000px; margin:0 auto; padding:80px 40px; position:relative;"
  >
    <div
      style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#22D3EE; margin-bottom:22px;"
    >
      Design studies
    </div>
    <h1
      style="font-weight:600; font-size:44px; line-height:1.06; letter-spacing:-.025em; margin:0 0 18px; color:#F2FBFC;"
    >
      Brand explorations behind the site.
    </h1>
    <p style="font-size:17px; line-height:1.6; color:#90A2AA; max-width:640px; margin:0 0 44px;">
      These pages are the design deliberations that led to the final wordmark, mark, and hero. They
      are not indexed — kept here for team reference only.
    </p>
    <div style="display:grid; grid-template-columns:1fr; gap:14px;">
      {
        studies.map((s) => (
          <a
            href={s.href}
            style="display:block; background:#0A0F14; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:22px 26px; color:inherit;"
          >
            <div style="font-weight:600; font-size:17px; color:#E6F0F2; margin-bottom:6px;">
              {s.title} →
            </div>
            <p style="margin:0; font-size:14px; color:#90A2AA; line-height:1.55;">{s.desc}</p>
          </a>
        ))
      }
    </div>
  </main>
</DesignStudy>
