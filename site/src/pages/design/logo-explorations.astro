---
import DesignStudy from '../../layouts/DesignStudy.astro';

interface Mark {
  n: string;
  name: string;
  desc: string;
  highlight?: boolean;
  svg: string;
}

const marks: Mark[] = [
  {
    n: '01',
    name: 'Timeline node',
    desc: 'A single point sits on a horizontal line — the smallest possible temporal symbol.',
    svg: '<line x1="8" y1="24" x2="40" y2="24" stroke="#8B9BFF" stroke-width="2"/><circle cx="24" cy="24" r="6" fill="#8B9BFF"/>',
  },
  {
    n: '02',
    name: 'Captured instant',
    desc: 'Brackets around a center dot — the moment is what the brackets enclose.',
    svg: '<path d="M14 12 L10 12 L10 36 L14 36" stroke="#8B9BFF" stroke-width="2" fill="none"/><path d="M34 12 L38 12 L38 36 L34 36" stroke="#8B9BFF" stroke-width="2" fill="none"/><circle cx="24" cy="24" r="4" fill="#8B9BFF"/>',
  },
  {
    n: '03',
    name: 'Radiating moment',
    desc: 'Concentric arcs radiate from a fixed center — a moment as ripple.',
    svg: '<circle cx="24" cy="24" r="4" fill="#8B9BFF"/><circle cx="24" cy="24" r="10" fill="none" stroke="#8B9BFF" stroke-width="1.5" opacity=".6"/><circle cx="24" cy="24" r="16" fill="none" stroke="#8B9BFF" stroke-width="1" opacity=".3"/>',
  },
  {
    n: '04',
    name: 'Crossing (signature)',
    desc: 'A curved arc between two nodes — the product‑signature symbol for a boundary crossing.',
    highlight: true,
    svg: '<path d="M8 12 C 20 12, 14 36, 40 36" stroke="#8B9BFF" stroke-width="2.5" fill="none"/><circle cx="8" cy="12" r="4" fill="#07090D" stroke="#8B9BFF" stroke-width="2"/><circle cx="40" cy="36" r="4" fill="#8B9BFF"/>',
  },
  {
    n: '05',
    name: 'Now marker',
    desc: 'A dashed timeline interrupted by a single vertical bar — the current moment.',
    svg: '<line x1="6" y1="24" x2="42" y2="24" stroke="#8B9BFF" stroke-width="1.5" stroke-dasharray="4 3"/><line x1="24" y1="10" x2="24" y2="38" stroke="#8B9BFF" stroke-width="3"/>',
  },
  {
    n: '06',
    name: 'App monogram',
    desc: 'A rounded square with two nodes on a line — reads as an app-icon primitive.',
    svg: '<rect x="6" y="6" width="36" height="36" rx="9" fill="#8B9BFF"/><line x1="14" y1="24" x2="34" y2="24" stroke="#07090D" stroke-width="2.2"/><circle cx="14" cy="24" r="3" fill="#07090D"/><circle cx="34" cy="24" r="3" fill="#07090D"/>',
  },
];
---

<DesignStudy title="Logo explorations">
  <div style="padding:60px 56px 100px; background:#0B0C0F;">
    <div style="max-width:1180px; margin:0 auto 48px;">
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:#8B9BFF; margin-bottom:18px;"
      >
        Moment · logo explorations
      </div>
      <h1
        style="font-weight:500; font-size:42px; line-height:1.08; letter-spacing:-.025em; margin:0 0 16px; color:#F2FBFC; max-width:780px;"
      >
        Six marks for a single idea: <span style="font-weight:700;">a point in time.</span>
      </h1>
      <ul
        style="margin:16px 0 0; padding-left:22px; font-size:15px; line-height:1.7; color:#B0B4BF; max-width:640px;"
      >
        <li>
          Each mark is shown large, in a wordmark lockup, at favicon scale, and on light.
        </li>
        <li>Monochrome by default; indigo <span style="color:#8B9BFF;">#8B9BFF</span> is the single accent.</li>
        <li>Wordmark set in Geist 600, lowercase — quiet, technical, calm.</li>
      </ul>
    </div>

    <div style="max-width:1180px; margin:0 auto; display:grid; grid-template-columns:repeat(3,1fr); gap:20px;">
      {
        marks.map((m) => (
          <div
            style={`background:#0F1116; border:1px solid ${m.highlight ? 'rgba(139,155,255,0.5)' : 'rgba(255,255,255,0.08)'}; border-radius:14px; padding:28px 26px; display:flex; flex-direction:column; gap:18px;`}
          >
            <div style="display:flex; align-items:baseline; gap:10px;">
              <span style="font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#8B9BFF;">
                {m.n}
              </span>
              <div style="font-weight:600; font-size:16px; color:#F2FBFC;">{m.name}</div>
            </div>
            <div style="display:flex; align-items:center; justify-content:center; padding:26px 0; background:rgba(139,155,255,0.04); border-radius:10px;">
              <svg width="96" height="96" viewBox="0 0 48 48" set:html={m.svg} />
            </div>
            <div style="display:flex; align-items:center; gap:14px; padding-top:14px; border-top:1px solid rgba(255,255,255,0.06);">
              <svg width="32" height="32" viewBox="0 0 48 48" set:html={m.svg} />
              <span style="font-family:'Geist',sans-serif; font-weight:600; font-size:18px; color:#F2FBFC; letter-spacing:-.02em;">
                moment
              </span>
            </div>
            <div style="display:flex; align-items:center; gap:14px;">
              <div style="width:16px; height:16px; display:flex; align-items:center; justify-content:center; background:#0B0C0F; border-radius:3px;">
                <svg width="16" height="16" viewBox="0 0 48 48" set:html={m.svg} />
              </div>
              <div style="flex:1; padding:8px 12px; background:#F4F5F7; border-radius:6px; display:flex; align-items:center; gap:8px;">
                <svg width="20" height="20" viewBox="0 0 48 48" set:html={m.svg.replaceAll('#8B9BFF', '#5b62d6').replaceAll('#07090D', '#F4F5F7')} />
                <span style="font-family:'Geist',sans-serif; font-weight:600; font-size:14px; color:#0B0C0F; letter-spacing:-.02em;">
                  moment
                </span>
              </div>
            </div>
            <p style="margin:0; font-size:13px; line-height:1.55; color:#8FA0A8;">{m.desc}</p>
          </div>
        ))
      }
    </div>

    <div
      style="max-width:1180px; margin:56px auto 0; padding:24px 30px; background:rgba(139,155,255,0.08); border:1px solid rgba(139,155,255,0.28); border-radius:14px;"
    >
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#8B9BFF; letter-spacing:.08em; margin-bottom:10px;"
      >
        Recommendation
      </div>
      <p style="margin:0; font-size:15.5px; line-height:1.6; color:#C9CDD6;">
        <strong>04 Crossing</strong> carries the product's signature; <strong>02 Instant</strong> is
        the most legible at favicon scale. Either is a defensible pick.
      </p>
    </div>
  </div>
</DesignStudy>
