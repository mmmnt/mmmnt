---
import Base from './Base.astro';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = `${title} — Moment design study` } = Astro.props;
---

<Base title={`${title} · Design`} description={description} noIndex>
  <div style="position:relative; overflow:hidden;">
    <div
      style="position:relative; border-bottom:1px solid rgba(255,255,255,0.06); background:rgba(7,9,13,0.8);"
    >
      <div
        class="site-container"
        style="max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; padding:16px 40px;"
      >
        <a href="/" style="display:flex; align-items:center; gap:11px;">
          <Wordmark size={20} />
          <span
            style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:#5b7077; border:1px solid rgba(255,255,255,0.12); border-radius:5px; padding:2px 6px; margin-left:4px;"
            >design study</span
          >
        </a>
        <a href="/design" class="link-muted" style="font-size:13px;">All design studies →</a>
      </div>
    </div>
    <slot />
  </div>
</Base>
