---
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<span class="wm" style={`font-size:${size}px;`}
  ><span style="font-weight:500;">m</span><span style="font-weight:700;">o</span><span
    style="font-weight:500;">m</span
  ><span style="font-weight:400;">e</span><span style="font-weight:300;">n</span><span
    style="font-weight:200;">t</span
  ><span class="pt" style="font-weight:700;">.</span></span
>
