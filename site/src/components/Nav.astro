---
import Wordmark from './Wordmark.astro';
import { GITHUB_URL } from '../consts';

type ActivePage = 'home' | 'why' | 'dsl' | 'ecosystem' | 'docs' | 'get-started' | null;

interface Props {
  active?: ActivePage;
  showVersionBadge?: boolean;
}
const { active = null, showVersionBadge = true } = Astro.props;

const items: Array<{ href: string; label: string; key: ActivePage }> = [
  { href: '/why', label: 'Why Moment', key: 'why' },
  { href: '/dsl', label: 'The DSL', key: 'dsl' },
  { href: '/ecosystem', label: 'Ecosystem', key: 'ecosystem' },
  { href: '/docs', label: 'Docs', key: 'docs' },
];
---

<div
  style="position:sticky; top:0; z-index:50; background:rgba(7,9,13,0.8); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); border-bottom:1px solid rgba(255,255,255,0.06);"
>
  <div
    class="site-container"
    style="max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; padding:18px 40px;"
  >
    <a href="/" aria-label="Moment home" style="display:flex; align-items:center; gap:11px;">
      <Wordmark size={22} />
      {
        showVersionBadge && (
          <span style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:#5b7077; border:1px solid rgba(255,255,255,0.12); border-radius:5px; padding:2px 6px; margin-left:4px;">
            DSL v1.0
          </span>
        )
      }
    </a>
    <nav
      class="nav-links"
      aria-label="Primary"
      style="display:flex; align-items:center; gap:32px; font-size:14.5px;"
    >
      {
        items.map((item) => (
          <a
            href={item.href}
            class={active === item.key ? 'link-active' : 'link-muted'}
            aria-current={active === item.key ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div style="display:flex; align-items:center; gap:16px;">
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        class="link-muted"
        style="font-size:14.5px;"
      >
        GitHub
      </a>
      <a
        href="/get-started"
        class="btn-primary"
        style="font-size:14px; font-weight:600; padding:9px 16px; border-radius:7px;"
      >
        Get started
      </a>
    </div>
  </div>
</div>
