---
import Wordmark from './Wordmark.astro';
import { GITHUB_URL, GITHUB_WIKI_URL, GITHUB_RELEASES_URL } from '../consts';
---

<footer style="position:relative; border-top:1px solid rgba(255,255,255,0.06); background:#060709;">
  <div
    class="site-container"
    style="max-width:1200px; margin:0 auto; padding:56px 40px 40px; display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:40px;"
  >
    <div>
      <Wordmark size={20} />
      <p style="margin:14px 0 0; font-size:13.5px; line-height:1.6; color:#5b7077; max-width:240px;">
        The open-source temporal dimension for domain-driven design. Part of the Complai ecosystem.
      </p>
    </div>
    <div>
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#5b7077; margin-bottom:14px;"
      >
        Product
      </div>
      <div style="display:flex; flex-direction:column; gap:10px; font-size:13.5px;">
        <a href="/why" class="link-footer">Why Moment</a>
        <a href="/dsl" class="link-footer">The DSL</a>
        <a href="/ecosystem" class="link-footer">Ecosystem</a>
        <a href="/get-started" class="link-footer">Get started</a>
      </div>
    </div>
    <div>
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#5b7077; margin-bottom:14px;"
      >
        Resources
      </div>
      <div style="display:flex; flex-direction:column; gap:10px; font-size:13.5px;">
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="link-footer">GitHub</a>
        <a href={GITHUB_WIKI_URL} target="_blank" rel="noopener" class="link-footer">Repo wiki</a>
        <a href="/docs" class="link-footer">Docs</a>
        <a href={GITHUB_RELEASES_URL} target="_blank" rel="noopener" class="link-footer"
          >Releases</a
        >
      </div>
    </div>
    <div>
      <div
        style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#5b7077; margin-bottom:14px;"
      >
        Complai
      </div>
      <div style="display:flex; flex-direction:column; gap:10px; font-size:13.5px;">
        <a href="/ecosystem" class="link-footer">Sift</a>
        <a href="/ecosystem" class="link-footer">Facet</a>
        <a href="/ecosystem" class="link-footer">Forge</a>
        <a href="/ecosystem" class="link-footer">Codex</a>
      </div>
    </div>
  </div>
  <div class="site-container" style="max-width:1200px; margin:0 auto; padding:0 40px 40px;">
    <div
      style="border-top:1px solid rgba(255,255,255,0.06); padding-top:22px; display:flex; justify-content:space-between; font-size:12.5px; color:#5b7077; font-family:'JetBrains Mono',monospace;"
    >
      <span>© 2026 Complai · Moment</span>
      <span>FSL-1.1-Apache-2.0</span>
    </div>
  </div>
</footer>
