---

---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__wordmark">
      <img src="/logos/moment-wordmark-tagline.svg" alt="Moment — Domain architecture for the AI era" class="hero__wordmark-img" />
    </div>
    <div class="hero__badge">
      <span class="hero__badge-dot"></span>
      Open Source &middot; FSL-1.1-Apache-2.0
    </div>
    <h1 class="hero__headline">
      Test your domain<br />
      <span class="hero__accent">before you code.</span>
    </h1>
    <p class="hero__subline">
      Moment is the first toolchain that lets you model, simulate, and validate
      domain flows <em>before writing a single line of implementation</em>.
      Write a <code>.moment</code> specification, generate simulation scenarios,
      and visualize them with Facet &mdash; then generate typed TypeScript, tests,
      docs, and API contracts from the same source of truth.
    </p>
    <div class="hero__cta">
      <a href="/get-started" class="btn btn--primary">Get Started</a>
      <a href="/why" class="btn btn--secondary">
        Why Moment?
      </a>
      <a
        href="https://github.com/mmmnt/mmmnt"
        class="btn btn--ghost"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
        </svg>
        Star on GitHub
      </a>
      <a
        href="https://discord.gg/YcRqsQUQuu"
        class="btn btn--ghost"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
        </svg>
        Join Discord
      </a>
    </div>
    <div class="hero__tools">
      <span class="hero__tools-label">Part of Complai:</span>
      <a href="https://sdd.mmmnt.dev" class="hero__tool-link" target="_blank" rel="noopener noreferrer">SDD</a>
      <span class="hero__tools-sep" aria-hidden="true">&middot;</span>
      <a href="/" class="hero__tool-link hero__tool-link--active">Moment</a>
      <span class="hero__tools-sep" aria-hidden="true">&middot;</span>
      <a href="/ecosystem#facet" class="hero__tool-link">Facet</a>
      <span class="hero__tools-sep" aria-hidden="true">&middot;</span>
      <a href="/ecosystem#forge" class="hero__tool-link">Forge</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-24) var(--space-6) var(--space-16);
    text-align: center;
  }

  .hero__inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-4);
    margin-bottom: var(--space-6);
    background: var(--color-accent-muted);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    border-radius: 100px;
    border: 1px solid var(--color-accent);
  }

  .hero__badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero__headline {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: -0.02em;
  }

  .hero__wordmark {
    margin-bottom: var(--space-6);
  }

  .hero__wordmark-img {
    height: clamp(3rem, 8vw, 5rem);
    width: auto;
    margin: 0 auto;
    display: block;
  }

  .hero__accent {
    background: var(--color-brand-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subline {
    max-width: 40rem;
    margin: 0 auto var(--space-8);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .hero__subline code {
    color: var(--color-accent);
    background: var(--color-accent-muted);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }

  .hero__cta {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
    text-decoration: none;
    cursor: pointer;
  }

  .btn--primary {
    background: var(--color-brand-gradient);
    color: #fff;
  }

  .btn--primary:hover {
    opacity: 0.9;
    color: #fff;
  }

  .btn--secondary {
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }

  .btn--secondary:hover {
    background: var(--color-border);
    color: var(--color-text-primary);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .btn--ghost:hover {
    color: var(--color-text-primary);
    background: var(--color-surface-raised);
  }

  .hero__tools {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }

  .hero__tools-label {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .hero__tool-link {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .hero__tool-link:hover {
    color: var(--color-accent);
  }

  .hero__tool-link--active {
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }

  .hero__tools-sep {
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
  }
</style>
